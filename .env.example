# Copy to .env and fill in what your CMS needs.
# Everything here is server-only: never prefix these with PUBLIC_.

# ------------------------------------------------------------
# Which CMS Inti writes to: wordpress | kitsuden | strapi | keystatic
# Unset: edits go to the local JSON store (for trying Inti out, not production)
# ------------------------------------------------------------
INTI_ADAPTER=
# INTI_LOCAL_STORE=.inti/content.json

# ------------------------------------------------------------
# WordPress (REST API + ACF)
# ------------------------------------------------------------
# INTI_WP_ENDPOINT=https://cms.example.com
# INTI_WP_USER=editor
# An application password (Users → Profile), not the account password
# INTI_WP_APP_PASSWORD=xxxx xxxx xxxx xxxx
# INTI_WP_BLOCKS_FIELD=content_blocks
# INTI_WP_POST_TYPE=pages

# ------------------------------------------------------------
# Kitsuden
# ------------------------------------------------------------
# INTI_KITSUDEN_ENDPOINT=https://cms.example.com
# An agent key (kitsuden_agent_…)
# INTI_KITSUDEN_TOKEN=
# INTI_KITSUDEN_MOUNT_PATH=
# INTI_KITSUDEN_STATUS=
# INTI_KITSUDEN_MEDIA_PRESET=

# ------------------------------------------------------------
# Strapi v4 / v5
# ------------------------------------------------------------
# INTI_STRAPI_ENDPOINT=https://cms.example.com
# INTI_STRAPI_TOKEN=
# INTI_STRAPI_CONTENT_TYPE=pages
# INTI_STRAPI_BLOCKS_FIELD=blocks

# ------------------------------------------------------------
# Keystatic
# Locally it edits the files in the project. In production set the
# repository and a token, so each edit is a commit.
# ------------------------------------------------------------
# INTI_KEYSTATIC_ROOT=
# INTI_KEYSTATIC_COLLECTION=pages
# INTI_KEYSTATIC_BLOCKS_FIELD=blocks
# INTI_KEYSTATIC_REPO=owner/repo
# INTI_KEYSTATIC_BRANCH=main
# INTI_KEYSTATIC_TOKEN=

# ------------------------------------------------------------
# Who can edit in production
# Outside development, writes are refused unless a plugin with
# resolveActor / beforeWrite decides who is editing (src/middleware.ts).
# Setting this to 1 opens editing to ANYONE. Only for private environments.
# ------------------------------------------------------------
# INTI_ALLOW_ANONYMOUS_WRITES=1

# ------------------------------------------------------------
# Realtime (editors seeing each other's changes)
# ------------------------------------------------------------
# INTI_REALTIME_ALLOWED_ORIGIN=https://www.example.com
# Several instances behind a load balancer: see createValkeyBackplane
# in @intijs/core/team and the deployment guide
# INTI_VALKEY_URL=redis://valkey:6379

# ------------------------------------------------------------
# Generative UI (@intijs/genui) — only if you use a model
# ------------------------------------------------------------
# ANTHROPIC_API_KEY=

# ------------------------------------------------------------
# MCP server (@intijs/mcp), for AI agents editing content
# ------------------------------------------------------------
# INTI_MCP_READONLY=1
# Path to a JSON vocabulary that validates what the agent inserts
# INTI_MCP_VOCABULARY=./inti.vocabulary.json
