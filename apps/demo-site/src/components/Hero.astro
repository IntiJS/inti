---
export interface Props {
    title: string;
    subtitle: string;
}

const { title, subtitle } = Astro.props;
---

<div
    class="px-6 py-24 sm:px-6 sm:py-32 lg:px-8 bg-slate-900 border-b border-white/10"
>
    <div class="mx-auto max-w-2xl text-center">
        <h2
            class="text-4xl font-bold tracking-tight text-white sm:text-6xl text-transparent bg-clip-text bg-gradient-to-tr from-[#FF7A00] to-[#FF004D]"
        >
            {title}
        </h2>
        <p class="mx-auto mt-6 max-w-xl text-lg/8 text-slate-300">
            {subtitle}
        </p>
        <div class="mt-10 flex items-center justify-center gap-x-6">
            <a
                href="#"
                class="rounded-md bg-[#FF004D] px-3.5 py-2.5 text-sm font-semibold text-white shadow-sm hover:bg-[#FF7A00] focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#FF004D] transition-all"
                >Start building</a
            >
            <a href="#" class="text-sm/6 font-semibold text-white"
                >View Documentation <span aria-hidden="true">→</span></a
            >
        </div>
    </div>
</div>
