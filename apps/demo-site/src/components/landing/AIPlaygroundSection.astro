---
// apps/demo-site/src/components/landing/AIPlaygroundSection.astro
---

<section id="ai-playground" class="py-20 sm:py-28 relative overflow-hidden bg-gradient-to-b from-[#06080F] via-[#0B0D1A] to-[#07090E] border-t border-white/10">
  <!-- Purple glow orb -->
  <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[700px] h-[500px] bg-purple-600/15 rounded-full blur-[140px] pointer-events-none -z-10"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Header -->
    <div class="text-center max-w-3xl mx-auto mb-16">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-purple-500/10 text-purple-300 border border-purple-500/20 text-xs font-semibold mb-4">
        <span>✨ Generative UI &amp; MCP Agents</span>
      </div>
      <h2 class="text-3xl sm:text-5xl font-extrabold text-white tracking-tight mb-4">
        AI that builds with your blocks.<br />
        <span class="text-transparent bg-clip-text bg-gradient-to-r from-purple-400 via-pink-400 to-amber-300">
          No freeform CSS. Nothing breaks.
        </span>
      </h2>
      <p class="text-slate-300 text-base sm:text-lg">
        The AI runs in your Astro site, never inside the CMS. It drafts proposals using only the blocks and fields you declare, and nothing is saved until you approve it.
      </p>
    </div>

    <!-- Interactive AI Composer Simulator -->
    <div class="rounded-2xl border border-white/15 bg-[#0D1120] shadow-2xl overflow-hidden mb-16">
      <!-- Terminal / Composer Header -->
      <div class="px-5 py-3.5 bg-[#090C17] border-b border-white/10 flex flex-wrap items-center justify-between gap-4">
        <div class="flex items-center gap-3">
          <div class="flex items-center gap-1.5">
            <span class="w-3 h-3 rounded-full bg-rose-500/80"></span>
            <span class="w-3 h-3 rounded-full bg-amber-500/80"></span>
            <span class="w-3 h-3 rounded-full bg-emerald-500/80"></span>
          </div>
          <span class="font-mono text-xs text-purple-300 font-semibold flex items-center gap-1.5">
            <span>✨ @intijs/genui</span>
            <span class="text-slate-600">|</span>
            <span class="text-slate-400">Constrained Composition Engine</span>
          </span>
        </div>
        <div class="text-[11px] font-mono text-emerald-400 flex items-center gap-1.5">
          <span class="w-2 h-2 rounded-full bg-emerald-400 animate-ping"></span>
          <span>Schema validated (Strict Block Vocabulary)</span>
        </div>
      </div>

      <!-- Main Interactive Composer Area -->
      <div class="grid grid-cols-1 lg:grid-cols-12 min-h-[460px]">
        <!-- Prompt & Control Panel (5 cols) -->
        <div class="lg:col-span-5 p-6 border-b lg:border-b-0 lg:border-r border-white/10 flex flex-col justify-between bg-black/30">
          <div>
            <label for="ai-prompt-input" class="block text-xs font-semibold uppercase tracking-wider text-slate-400 mb-2">
              Prompt for the LLM:
            </label>
            <div class="relative mb-4">
              <textarea
                id="ai-prompt-input"
                rows="3"
                class="w-full bg-[#13192B] border border-white/10 focus:border-purple-400 rounded-xl p-3 text-sm text-white placeholder-slate-500 focus:outline-none transition-all resize-none font-sans"
                placeholder="Describe the section you want to build..."
              >Create a customer testimonials section with satisfaction metrics and a solar theme.</textarea>
            </div>

            <!-- Quick Preset Chips -->
            <div class="mb-6">
              <span class="text-[11px] text-slate-400 block mb-2 font-medium">Quick examples:</span>
              <div class="flex flex-wrap gap-2">
                <button
                  type="button"
                  class="preset-prompt-btn px-2.5 py-1 rounded-lg bg-white/5 hover:bg-white/10 text-[11px] text-slate-300 border border-white/5 transition-all text-left"
                  data-prompt="Create a customer testimonials section with satisfaction metrics and a solar theme."
                >
                  💬 Testimonials &amp; Metrics
                </button>
                <button
                  type="button"
                  class="preset-prompt-btn px-2.5 py-1 rounded-lg bg-white/5 hover:bg-white/10 text-[11px] text-slate-300 border border-white/5 transition-all text-left"
                  data-prompt="Generate a SaaS pricing table with 3 tiers (Starter, Pro, Enterprise) and a highlighted button."
                >
                  💳 3-Tier SaaS Pricing
                </button>
                <button
                  type="button"
                  class="preset-prompt-btn px-2.5 py-1 rounded-lg bg-white/5 hover:bg-white/10 text-[11px] text-slate-300 border border-white/5 transition-all text-left"
                  data-prompt="Build a call to action with a 30% discount countdown and a money-back guarantee."
                >
                  🔥 Limited-Time Promo Banner
                </button>
              </div>
            </div>

            <!-- Generate Button -->
            <button
              type="button"
              id="btn-run-genui"
              class="w-full py-3 rounded-xl bg-gradient-to-r from-purple-500 via-pink-500 to-orange-500 text-white font-semibold text-sm shadow-lg shadow-purple-500/25 hover:shadow-purple-500/40 hover:brightness-110 active:scale-95 transition-all flex items-center justify-center gap-2"
            >
              <svg class="w-4 h-4" id="ai-btn-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/>
              </svg>
              <span id="ai-btn-text">Compose with GenUI</span>
            </button>
          </div>

          <!-- Strict Safety Note -->
          <div class="mt-6 p-3 rounded-xl bg-purple-500/10 border border-purple-500/20 text-xs text-purple-200 leading-relaxed">
            <strong class="text-purple-300 block mb-0.5">🔒 Strict Vocabulary Guarantee:</strong>
            The model never invents HTML or arbitrary Tailwind classes. It only fills in the typed props of your existing Astro blocks.
          </div>
        </div>

        <!-- Live Generated Section Preview (7 cols) -->
        <div class="lg:col-span-7 p-6 sm:p-8 flex flex-col justify-between bg-gradient-to-b from-[#0D1120] to-[#0A0D17] relative">
          <!-- Live Preview Container -->
          <div>
            <div class="flex items-center justify-between pb-3 mb-4 border-b border-white/10 text-xs">
              <span class="text-slate-400 font-semibold uppercase tracking-wider text-[11px]">Proposal Preview</span>
              <span id="ai-status-pill" class="px-2 py-0.5 rounded bg-purple-500/20 text-purple-300 text-[10px] font-bold">
                Proposal Ready · Not saved to CMS
              </span>
            </div>

            <!-- The Generated Block Canvas -->
            <div id="ai-generated-canvas" class="transition-all duration-300">
              <!-- Default: Testimonials & Metrics -->
              <div class="rounded-xl p-6 bg-slate-900/80 border border-amber-500/30 shadow-xl space-y-4">
                <div class="flex items-center justify-between">
                  <span class="px-2.5 py-1 rounded bg-amber-500/10 text-amber-300 text-xs font-semibold">Verified Testimonials</span>
                  <span class="text-amber-400 text-sm">★★★★★ 4.9/5</span>
                </div>
                <h4 class="text-xl font-bold text-white">"We moved our frontend to Astro in 3 days without touching WordPress"</h4>
                <p class="text-slate-300 text-xs sm:text-sm leading-relaxed">
                  Our writers still use the same WordPress dashboard they always have, but now they can edit right on the live design. Page load speed improved by 340%.
                </p>
                <div class="pt-3 border-t border-white/10 flex items-center justify-between text-xs text-slate-400">
                  <span class="font-semibold text-slate-200">Elena Ramos · CTO at NovaMedia</span>
                  <span class="font-mono text-emerald-400">100/100 Core Web Vitals</span>
                </div>
              </div>
            </div>
          </div>

          <!-- Accept & Persist Toolbar -->
          <div class="mt-6 pt-4 border-t border-white/10 flex flex-wrap items-center justify-between gap-3">
            <div class="text-xs text-slate-400">
              <span>Block type:</span>
              <code id="ai-block-type-badge" class="ml-1 text-amber-300 font-mono bg-white/5 px-2 py-0.5 rounded">TestimonialGrid</code>
            </div>
            <div class="flex items-center gap-2">
              <button
                type="button"
                id="btn-discard-ai"
                class="px-3 py-1.5 rounded-lg bg-white/5 hover:bg-white/10 text-xs text-slate-300 transition-all"
              >
                Discard
              </button>
              <button
                type="button"
                id="btn-accept-ai"
                class="px-4 py-1.5 rounded-lg bg-emerald-500 hover:bg-emerald-600 text-white font-semibold text-xs shadow-md transition-all flex items-center gap-1.5"
              >
                <span>✓ Accept &amp; Save to CMS</span>
              </button>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- AI Agents via MCP Showcase Card -->
    <div class="rounded-2xl p-8 bg-gradient-to-r from-purple-950/30 via-slate-900 to-indigo-950/30 border border-purple-500/20 shadow-2xl flex flex-col lg:flex-row items-center justify-between gap-8">
      <div class="space-y-3 max-w-xl text-left">
        <div class="inline-flex items-center gap-2 px-2.5 py-1 rounded bg-purple-500/20 text-purple-300 font-mono text-xs">
          @intijs/mcp
        </div>
        <h3 class="text-2xl font-bold text-white">Autonomous Editing for Agents (Claude &amp; Cursor)</h3>
        <p class="text-slate-300 text-sm leading-relaxed">
          Let AI agents read your page, discover the available blocks and propose editorial improvements. Their writes go through exactly the same permissions and validation as a human editor's.
        </p>
        <div class="flex flex-wrap gap-2 text-xs font-mono text-slate-400 pt-2">
          <span class="px-2.5 py-1 rounded bg-black/40 border border-white/5 text-purple-300">inti_get_page</span>
          <span class="px-2.5 py-1 rounded bg-black/40 border border-white/5 text-purple-300">inti_update_field</span>
          <span class="px-2.5 py-1 rounded bg-black/40 border border-white/5 text-purple-300">inti_create_draft</span>
        </div>
      </div>

      <div class="w-full lg:w-auto shrink-0 bg-black/80 rounded-xl p-4 border border-white/10 font-mono text-xs text-slate-300 space-y-2 max-w-md">
        <div class="text-slate-500 pb-1 border-b border-white/10 flex justify-between">
          <span>MCP Setup</span>
          <span>claude_desktop_config.json</span>
        </div>
        <p class="text-amber-400">$ claude mcp add inti -- npx @intijs/mcp</p>
        <p class="text-slate-400">> "Claude, read the home page and tighten the hero headline to boost conversions."</p>
        <p class="text-emerald-400">✔ Tool called: inti_update_field (draft created)</p>
      </div>
    </div>
  </div>
</section>

<script>
  // AI Composer Playground logic
  const promptInput = document.getElementById('ai-prompt-input') as HTMLTextAreaElement;
  const btnRun = document.getElementById('btn-run-genui');
  const btnText = document.getElementById('ai-btn-text');
  const canvas = document.getElementById('ai-generated-canvas');
  const statusPill = document.getElementById('ai-status-pill');
  const blockBadge = document.getElementById('ai-block-type-badge');
  const btnAccept = document.getElementById('btn-accept-ai');
  const btnDiscard = document.getElementById('btn-discard-ai');
  const presetBtns = document.querySelectorAll('.preset-prompt-btn');

  presetBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      const p = btn.getAttribute('data-prompt');
      if (p && promptInput) {
        promptInput.value = p;
        runGeneration(p);
      }
    });
  });

  btnRun?.addEventListener('click', () => {
    if (promptInput) {
      runGeneration(promptInput.value);
    }
  });

  function runGeneration(prompt: string) {
    if (!canvas || !statusPill || !btnText || !blockBadge) return;

    btnText.textContent = 'Validating vocabulary...';
    statusPill.textContent = 'Composing with safe blocks...';
    statusPill.className = 'px-2 py-0.5 rounded bg-amber-500/20 text-amber-300 text-[10px] font-bold animate-pulse';

    setTimeout(() => {
      btnText.textContent = 'Compose with GenUI';
      statusPill.textContent = 'Proposal Validated ✔ (Awaiting Approval)';
      statusPill.className = 'px-2 py-0.5 rounded bg-purple-500/20 text-purple-300 text-[10px] font-bold';

      const lower = prompt.toLowerCase();
      if (lower.includes('pric') || lower.includes('saas') || lower.includes('table')) {
        blockBadge.textContent = 'PricingTableSection';
        canvas.innerHTML = `
          <div class="rounded-xl p-6 bg-slate-900/90 border border-purple-500/40 shadow-xl space-y-4">
            <div class="flex items-center justify-between">
              <span class="px-2.5 py-1 rounded bg-purple-500/10 text-purple-300 text-xs font-semibold">Transparent Pricing</span>
              <span class="text-xs text-slate-400">Cancel anytime</span>
            </div>
            <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 text-center">
              <div class="p-3 rounded-lg bg-black/40 border border-white/5">
                <span class="text-xs text-slate-400">Starter</span>
                <p class="text-xl font-bold text-white mt-1">€0</p>
                <span class="text-[10px] text-slate-500">Up to 3 blocks</span>
              </div>
              <div class="p-3 rounded-lg bg-gradient-to-b from-purple-500/20 to-black/60 border border-purple-400/40 relative">
                <span class="text-[9px] uppercase font-bold text-amber-400 bg-black/60 px-1.5 py-0.5 rounded absolute -top-2 left-1/2 -translate-x-1/2">Popular</span>
                <span class="text-xs text-purple-300 font-semibold">Pro</span>
                <p class="text-xl font-bold text-white mt-1">€29<span class="text-xs text-slate-400 font-normal">/mo</span></p>
                <span class="text-[10px] text-emerald-400">Unlimited blocks + MCP</span>
              </div>
              <div class="p-3 rounded-lg bg-black/40 border border-white/5">
                <span class="text-xs text-slate-400">Enterprise</span>
                <p class="text-xl font-bold text-white mt-1">Custom</p>
                <span class="text-[10px] text-slate-500">SSO & Dedicated SLA</span>
              </div>
            </div>
          </div>
        `;
      } else if (lower.includes('promo') || lower.includes('discount') || lower.includes('banner')) {
        blockBadge.textContent = 'UrgentCtaBanner';
        canvas.innerHTML = `
          <div class="rounded-xl p-6 bg-gradient-to-r from-rose-950/40 via-slate-900 to-orange-950/40 border border-rose-500/40 shadow-xl space-y-3">
            <div class="flex items-center gap-2">
              <span class="w-2.5 h-2.5 rounded-full bg-rose-500 animate-ping"></span>
              <span class="text-xs font-bold uppercase tracking-wider text-rose-400">Limited Time · 30% OFF</span>
            </div>
            <h4 class="text-2xl font-black text-white">Modernize your frontend today</h4>
            <p class="text-slate-300 text-xs sm:text-sm">
              Get the full visual editing stack, with write-back, for your entire editorial team.
            </p>
            <div class="pt-2 flex items-center gap-4">
              <span class="px-3 py-1.5 rounded-lg bg-rose-500 text-white font-bold text-xs">Claim Discount</span>
              <span class="text-xs text-slate-400 font-mono">Code: INTI2026</span>
            </div>
          </div>
        `;
      } else {
        blockBadge.textContent = 'TestimonialGrid';
        canvas.innerHTML = `
          <div class="rounded-xl p-6 bg-slate-900/80 border border-amber-500/30 shadow-xl space-y-4">
            <div class="flex items-center justify-between">
              <span class="px-2.5 py-1 rounded bg-amber-500/10 text-amber-300 text-xs font-semibold">Verified Testimonials</span>
              <span class="text-amber-400 text-sm">★★★★★ 4.9/5</span>
            </div>
            <h4 class="text-xl font-bold text-white">"We moved our frontend to Astro in 3 days without touching WordPress"</h4>
            <p class="text-slate-300 text-xs sm:text-sm leading-relaxed">
              Our writers still use the same WordPress dashboard they always have, but now they can edit right on the live design. Page load speed improved by 340%.
            </p>
            <div class="pt-3 border-t border-white/10 flex items-center justify-between text-xs text-slate-400">
              <span class="font-semibold text-slate-200">Elena Ramos · CTO at NovaMedia</span>
              <span class="font-mono text-emerald-400">100/100 Core Web Vitals</span>
            </div>
          </div>
        `;
      }
    }, 600);
  }

  btnAccept?.addEventListener('click', () => {
    if (statusPill) {
      statusPill.textContent = '✔ Saved to the CMS (200 OK)';
      statusPill.className = 'px-2 py-0.5 rounded bg-emerald-500/20 text-emerald-400 text-[10px] font-bold';
      setTimeout(() => {
        statusPill.textContent = 'Block Saved in CMS';
      }, 2500);
    }
  });

  btnDiscard?.addEventListener('click', () => {
    if (statusPill) {
      statusPill.textContent = 'Proposal discarded';
      statusPill.className = 'px-2 py-0.5 rounded bg-rose-500/20 text-rose-400 text-[10px] font-bold';
    }
  });
</script>
