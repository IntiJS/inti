---
// apps/demo-site/src/components/landing/AIPlaygroundSection.astro
// A simulation: three canned examples, no model is called and nothing is saved.
---

<section id="ai-playground" class="field field--sun">
  <div class="dome" data-scroll></div>
  <div class="wrap">
    <h2 class="h-pair" data-scroll>
      <span class="h-display drift-l">AI that builds with your blocks.</span>
      <span class="h-serif drift-r">No generated HTML, CSS or code.</span>
    </h2>
    <p class="lede" style="margin-bottom: clamp(1.75rem, 3.5vw, 3rem)">
      The AI runs on your Astro site and in its editor, never inside the CMS. It composes with the blocks and fields you declared, the proposal is previewed on the page, and it is written only when accepted.
    </p>

    <!-- Composer simulation -->
    <div class="win">
      <div class="win-bar">
        <span class="win-field">
          <span class="win-dots" aria-hidden="true"><i></i><i></i><i></i></span>
          <span class="mono">@intijs/genui</span>
        </span>
        <span class="sim">Simulated: canned examples, no model is called</span>
      </div>

      <div class="ai-grid">
        <div class="ai-ask">
          <div>
            <label for="ai-prompt-input">Describe the section:</label>
            <textarea id="ai-prompt-input" rows="3" placeholder="Describe the section you want to build...">A section with the opening hours of the bakery.</textarea>

            <div class="ai-presets" role="group" aria-labelledby="ai-presets-label">
              <span class="ai-small" id="ai-presets-label" style="flex-basis: 100%; margin: 0">The three examples this simulation knows:</span>
              <button type="button" class="preset-prompt-btn" data-example="hours" data-prompt="A section with the opening hours of the bakery.">Opening hours</button>
              <button type="button" class="preset-prompt-btn" data-example="grid" data-prompt="Three highlights from the menu, side by side.">Three highlights</button>
              <button type="button" class="preset-prompt-btn" data-example="cta" data-prompt="A call to action to order a cake.">Call to action</button>
            </div>

            <button type="button" id="btn-run-genui" class="btn" style="width: 100%">Show an example proposal</button>
          </div>

          <div class="ai-real">
            <strong>In the real package:</strong>
            The model picks from your declared blocks and fills in their fields. It generates no HTML, CSS or code, and everything it returns is validated before it is used. You bring your own model key, or Workers AI.
          </div>
        </div>

        <div class="ai-out">
          <div>
            <div class="ai-out-head">
              <span>Proposal preview, sample content</span>
              <span id="ai-status-pill" class="ai-pill" role="status">Simulated proposal: nothing is saved</span>
            </div>

            <!-- The example block. Filled in by the script below -->
            <div id="ai-generated-canvas"></div>
          </div>

          <div class="ai-out-foot">
            <span>Example block type: <code id="ai-block-type-badge" class="kbd-code">OpeningHours</code></span>
            <div>
              <button type="button" id="btn-discard-ai" class="btn btn--paper btn--small">Discard</button>
              <button type="button" id="btn-accept-ai" class="btn btn--small">Accept</button>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Agents over MCP -->
    <div class="mcp">
      <div>
        <span class="kbd-code">@intijs/mcp</span>
        <h3>Editing for agents (Claude Code, Cursor)</h3>
        <p>
          The adapter's write path, exposed as Model Context Protocol tools. Agent writes use the CMS credentials in the server's environment and do not pass through your <code class="kbd-code">beforeWrite</code> plugins: limit them with <code class="kbd-code">INTI_MCP_READONLY=1</code> or a restricted CMS user, validate what they insert with <code class="kbd-code">INTI_MCP_VOCABULARY</code>, and have them work on a draft.
        </p>
        <div class="mcp-tools">
          <span class="chip mono">inti_get_page</span>
          <span class="chip mono">inti_update_field</span>
          <span class="chip mono">inti_create_draft</span>
        </div>
      </div>

      <div class="code">
        <div class="code-head">
          <span>MCP setup</span>
          <span>Claude Code</span>
        </div>
        <p class="tk-c"># today, from a built clone:</p>
        <p class="tk-s">$ claude mcp add inti -- node /path/to/inti/packages/mcp/bin/inti-mcp.js</p>
        <p class="tk-c"># once published:</p>
        <p class="tk-s">$ claude mcp add inti -- npx -y @intijs/mcp</p>
        <p>&gt; "Read the home page and make the hero heading more direct."</p>
        <p class="tk-k">→ inti_get_page, then inti_update_field</p>
      </div>
    </div>
  </div>
</section>

<script>
  // Composer simulation. No request is made: the three examples are written here.
  const promptInput = document.getElementById('ai-prompt-input') as HTMLTextAreaElement | null;
  const btnRun = document.getElementById('btn-run-genui');
  const canvas = document.getElementById('ai-generated-canvas');
  const statusPill = document.getElementById('ai-status-pill');
  const blockBadge = document.getElementById('ai-block-type-badge');
  const btnAccept = document.getElementById('btn-accept-ai');
  const btnDiscard = document.getElementById('btn-discard-ai');
  const presetBtns = document.querySelectorAll<HTMLElement>('.preset-prompt-btn');

  const EXAMPLES: Record<string, { type: string; html: string }> = {
    hours: {
      type: 'OpeningHours',
      html: `
        <div class="sample">
          <span class="sample-tag">Sample content</span>
          <h4>Opening hours</h4>
          <ul>
            <li>Monday to Friday: morning and afternoon</li>
            <li>Saturday: morning only</li>
            <li>Sunday: closed</li>
          </ul>
        </div>`,
    },
    grid: {
      type: 'FeatureGrid',
      html: `
        <div class="sample sample--grid">
          <span class="sample-tag">Sample content</span>
          <div class="sample-cols">
            <div><b>Sourdough</b><span>Sample description</span></div>
            <div><b>Rye loaf</b><span>Sample description</span></div>
            <div><b>Cinnamon rolls</b><span>Sample description</span></div>
          </div>
        </div>`,
    },
    cta: {
      type: 'CallToAction',
      html: `
        <div class="sample sample--cta">
          <span class="sample-tag">Sample content</span>
          <h4>Order a cake for the weekend</h4>
          <p>Sample text for a made-up bakery.</p>
          <span class="sample-btn">Order now</span>
        </div>`,
    },
  };

  function pickExample(prompt: string): string {
    const lower = prompt.toLowerCase();
    if (lower.includes('three') || lower.includes('highlight') || lower.includes('menu')) return 'grid';
    if (lower.includes('action') || lower.includes('order') || lower.includes('cake')) return 'cta';
    return 'hours';
  }

  function setStatus(text: string, tone: string) {
    if (!statusPill) return;
    statusPill.textContent = text;
    statusPill.dataset.tone = tone;
  }

  function show(example: string) {
    const chosen = EXAMPLES[example] ?? EXAMPLES.hours;
    if (canvas) canvas.innerHTML = chosen.html;
    if (blockBadge) blockBadge.textContent = chosen.type;
    setStatus('Simulated proposal: nothing is saved', 'idle');
  }

  presetBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      if (promptInput && btn.dataset.prompt) promptInput.value = btn.dataset.prompt;
      show(btn.dataset.example ?? 'hours');
    });
  });

  btnRun?.addEventListener('click', () => show(pickExample(promptInput?.value ?? '')));

  btnAccept?.addEventListener('click', () => {
    setStatus('Simulated: a real project would now save these blocks to your CMS', 'ok');
  });

  btnDiscard?.addEventListener('click', () => {
    if (canvas) canvas.innerHTML = '<p>Proposal discarded. Nothing was saved.</p>';
    setStatus('Simulated: proposal discarded', 'no');
  });

  show('hours');
</script>
