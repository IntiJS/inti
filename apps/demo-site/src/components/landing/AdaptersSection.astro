---
// apps/demo-site/src/components/landing/AdaptersSection.astro
---

<section id="adapters" class="field field--paper">
  <div class="dome" data-scroll></div>
  <div class="wrap">
    <h2 class="h-pair" data-scroll>
      <span class="h-display drift-l">Adapters for the CMS you already have.</span>
      <span class="h-serif drift-r">One contract, whichever CMS.</span>
    </h2>
    <p class="lede">
      Any adapter that implements <code class="kbd-code">WritableAdapter</code> gets inline editing. WordPress, Kitsuden, Strapi and Keystatic read and write; Contentful and Sanity are read-only today.
    </p>

    <div class="tabs" role="tablist" aria-label="Adapters">
      <button type="button" role="tab" class="adapter-tab" id="adapter-tab-wp" data-adapter="wp" aria-selected="true" aria-controls="adapter-panel-wp">WordPress (ACF + Gutenberg)</button>
      <button type="button" role="tab" class="adapter-tab" id="adapter-tab-kitsuden" data-adapter="kitsuden" aria-selected="false" aria-controls="adapter-panel-kitsuden" tabindex="-1">Kitsuden</button>
      <button type="button" role="tab" class="adapter-tab" id="adapter-tab-strapi" data-adapter="strapi" aria-selected="false" aria-controls="adapter-panel-strapi" tabindex="-1">Strapi (Dynamic Zones)</button>
      <button type="button" role="tab" class="adapter-tab" id="adapter-tab-keystatic" data-adapter="keystatic" aria-selected="false" aria-controls="adapter-panel-keystatic" tabindex="-1">Keystatic (Git-backed)</button>
      <button type="button" role="tab" class="adapter-tab" id="adapter-tab-local" data-adapter="local" aria-selected="false" aria-controls="adapter-panel-local" tabindex="-1">Local Store (JSON)</button>
    </div>

    <!-- WordPress -->
    <div id="adapter-panel-wp" class="adapter adapter-panel" role="tabpanel" aria-labelledby="adapter-tab-wp">
      <div>
        <span class="kbd-code">@intijs/adapter-wordpress</span>
        <h3>Headless WordPress</h3>
        <p>
          <strong>ACF Flexible Content</strong> layouts map 1:1 to Inti blocks. Read via the standard REST API (<code class="kbd-code">wp/v2</code>) and written using secure Application Passwords stored in your Astro server's environment variables.
        </p>
        <ul class="ticks">
          <li><strong>Gutenberg Mode:</strong> standard headings and paragraphs are inline-editable with a conservative parser.</li>
          <li><strong>Optional Companion Plugin:</strong> <code class="kbd-code">inti-bridge.php</code> for atomic patches without full-array round-trips.</li>
          <li>Inherits SEO metadata from Yoast, RankMath, SEOPress, or AIOSEO.</li>
        </ul>
      </div>
      <div class="code" tabindex="0" role="region" aria-label="WordPress adapter code">
        <div class="code-head">
          <span>src/pages/[...slug].astro</span>
          <span>TypeScript</span>
        </div>
        <pre><code><span class="tk-k">import</span> &#123; WordPressAdapter &#125; <span class="tk-k">from</span> <span class="tk-s">'@intijs/adapter-wordpress'</span>;
<span class="tk-k">import</span> &#123; registerBlocks &#125; <span class="tk-k">from</span> <span class="tk-s">'@intijs/core/registry'</span>;
<span class="tk-k">import</span> BlockRenderer <span class="tk-k">from</span> <span class="tk-s">'@intijs/core/astro/BlockRenderer.astro'</span>;
<span class="tk-k">import</span> VisualBridgeAuto <span class="tk-k">from</span> <span class="tk-s">'@intijs/core/visual-bridge/VisualBridgeAuto.astro'</span>;

registerBlocks(<span class="tk-k">import</span>.meta.glob(<span class="tk-s">'/src/blocks/*.astro'</span>));

<span class="tk-k">const</span> adapter = <span class="tk-k">new</span> WordPressAdapter(&#123; endpoint: <span class="tk-k">import</span>.meta.env.INTI_WP_ENDPOINT &#125;);
<span class="tk-k">const</span> page = <span class="tk-k">await</span> adapter.fetchPageBySlug(Astro.params.slug ?? <span class="tk-s">'home'</span>);
---
&lt;BlockRenderer blocks=&#123;page.blocks&#125; /&gt;
&lt;VisualBridgeAuto /&gt;</code></pre>
      </div>
    </div>

    <!-- Kitsuden -->
    <div id="adapter-panel-kitsuden" class="adapter adapter-panel" role="tabpanel" aria-labelledby="adapter-tab-kitsuden" hidden>
      <div>
        <span class="kbd-code">@intijs/adapter-kitsuden</span>
        <h3>Kitsuden Page Builder</h3>
        <p>
          Kitsuden is a separate project: a backend built for AI agents. Each block row is addressed by its <strong>uuid</strong>, so a reorder in the admin never makes an edit land on the wrong block.
        </p>
        <ul class="ticks">
          <li><strong>Single-scope agent key:</strong> writes use an agent key with the single scope <code class="kbd-code">content:edit</code>.</li>
          <li><strong>Contract check:</strong> asks <code class="kbd-code">GET /api/version</code> before its first write.</li>
          <li>Also edits the title and description of Kitsuden game sheets.</li>
        </ul>
      </div>
      <div class="code" tabindex="0" role="region" aria-label="Kitsuden adapter code">
        <div class="code-head">
          <span>src/lib/cms.ts</span>
          <span>TypeScript</span>
        </div>
        <pre><code><span class="tk-k">import</span> &#123; KitsudenAdapter &#125; <span class="tk-k">from</span> <span class="tk-s">'@intijs/adapter-kitsuden'</span>;

<span class="tk-c">// Reading published pages needs no key. Writes use INTI_KITSUDEN_TOKEN</span>
<span class="tk-c">// (an agent key, kitsuden_agent_…), on the server only.</span>
<span class="tk-k">const</span> adapter = <span class="tk-k">new</span> KitsudenAdapter(&#123; endpoint: <span class="tk-s">'https://cms.example.com'</span> &#125;);
<span class="tk-k">const</span> page = <span class="tk-k">await</span> adapter.getPage(<span class="tk-s">'home'</span>);</code></pre>
      </div>
    </div>

    <!-- Strapi -->
    <div id="adapter-panel-strapi" class="adapter adapter-panel" role="tabpanel" aria-labelledby="adapter-tab-strapi" hidden>
      <div>
        <span class="kbd-code">@intijs/adapter-strapi</span>
        <h3>Strapi v4 &amp; v5 Dynamic Zones</h3>
        <p>
          The components of a Strapi dynamic zone become Inti blocks, rendered by your Astro components and editable on the page.
        </p>
        <ul class="ticks">
          <li>Works with Strapi v4 and v5.</li>
          <li>Writes use an API token with update permission, kept on the server.</li>
          <li>Reads the page's <code class="kbd-code">seo</code> component into <code class="kbd-code">page.seo</code>.</li>
        </ul>
      </div>
      <div class="code" tabindex="0" role="region" aria-label="Strapi adapter code">
        <div class="code-head">
          <span>src/lib/cms.ts</span>
          <span>TypeScript</span>
        </div>
        <pre><code><span class="tk-k">import</span> &#123; StrapiAdapter &#125; <span class="tk-k">from</span> <span class="tk-s">'@intijs/adapter-strapi'</span>;

<span class="tk-k">const</span> adapter = <span class="tk-k">new</span> StrapiAdapter(&#123; endpoint: <span class="tk-s">'https://strapi.example.com'</span> &#125;);
<span class="tk-k">const</span> page = <span class="tk-k">await</span> adapter.fetchPageBySlug(<span class="tk-s">'home'</span>);

<span class="tk-c">// .env, server only (never PUBLIC_):</span>
<span class="tk-c">// INTI_ADAPTER=strapi</span>
<span class="tk-c">// INTI_STRAPI_ENDPOINT=https://strapi.example.com</span>
<span class="tk-c">// INTI_STRAPI_TOKEN=   an API token with update permission</span></code></pre>
      </div>
    </div>

    <!-- Keystatic -->
    <div id="adapter-panel-keystatic" class="adapter adapter-panel" role="tabpanel" aria-labelledby="adapter-tab-keystatic" hidden>
      <div>
        <span class="kbd-code">@intijs/adapter-keystatic</span>
        <h3>Visual Editing on Git</h3>
        <p>
          Keystatic shines at storing your content in local files or GitHub repositories. Inti adds the missing piece: <strong>editing on the real page</strong>, writing to its YAML or JSON files, locally or as a GitHub commit.
        </p>
      </div>
      <div class="code" tabindex="0" role="region" aria-label="Keystatic adapter code">
        <pre><code><span class="tk-k">import</span> &#123; KeystaticAdapter &#125; <span class="tk-k">from</span> <span class="tk-s">'@intijs/adapter-keystatic'</span>;

<span class="tk-k">const</span> adapter = <span class="tk-k">new</span> KeystaticAdapter(&#123; collection: <span class="tk-s">'content/pages/*'</span>, blocksField: <span class="tk-s">'blocks'</span> &#125;);
<span class="tk-k">const</span> page = <span class="tk-k">await</span> adapter.fetchPageBySlug(<span class="tk-s">'home'</span>);

<span class="tk-c">// In production set INTI_KEYSTATIC_REPO and INTI_KEYSTATIC_TOKEN:</span>
<span class="tk-c">// each edit becomes a GitHub commit.</span></code></pre>
      </div>
    </div>

    <!-- Local store -->
    <div id="adapter-panel-local" class="adapter adapter-panel" role="tabpanel" aria-labelledby="adapter-tab-local" hidden>
      <div>
        <span class="kbd-code">LocalAdapter (Batteries included)</span>
        <h3>Try it without connecting any CMS</h3>
        <p>
          Want to try inline editing before connecting your backend? <code class="kbd-code">LocalAdapter</code> writes to <code class="kbd-code">.inti/content.json</code> while satisfying the exact same contract as WordPress or Kitsuden.
        </p>
      </div>
      <div class="code" tabindex="0" role="region" aria-label="Local adapter code">
        <pre><code><span class="tk-c">// Zero setup required locally:</span>
<span class="tk-k">import</span> &#123; LocalAdapter &#125; <span class="tk-k">from</span> <span class="tk-s">'@intijs/core/adapters/local'</span>;

<span class="tk-k">const</span> adapter = <span class="tk-k">new</span> LocalAdapter();
<span class="tk-c">// Double-click to edit and watch it save to .inti/content.json</span></code></pre>
      </div>
    </div>
  </div>
</section>

<script>
  // Tabs: click, or the arrow keys while a tab has focus
  const tabs = Array.from(document.querySelectorAll<HTMLElement>('.adapter-tab'));
  const panels = document.querySelectorAll<HTMLElement>('.adapter-panel');

  function select(tab: HTMLElement, focus = false) {
    for (const other of tabs) {
      const active = other === tab;
      other.setAttribute('aria-selected', String(active));
      other.tabIndex = active ? 0 : -1;
    }
    panels.forEach((panel) => { panel.hidden = panel.id !== `adapter-panel-${tab.dataset.adapter}`; });
    if (focus) tab.focus();
  }

  tabs.forEach((tab, index) => {
    tab.addEventListener('click', () => select(tab));
    tab.addEventListener('keydown', (event) => {
      let next = -1;
      if (event.key === 'ArrowRight' || event.key === 'ArrowDown') next = (index + 1) % tabs.length;
      else if (event.key === 'ArrowLeft' || event.key === 'ArrowUp') next = (index - 1 + tabs.length) % tabs.length;
      else if (event.key === 'Home') next = 0;
      else if (event.key === 'End') next = tabs.length - 1;
      if (next < 0) return;
      event.preventDefault();
      select(tabs[next], true);
    });
  });
</script>
