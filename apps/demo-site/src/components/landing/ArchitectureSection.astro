---
// apps/demo-site/src/components/landing/ArchitectureSection.astro
// The route of one save, in order. The sun on the line follows the scroll.

const steps = [
  {
    title: 'Editor Browser',
    text: 'Double-click on the Astro-rendered block. The editor sees the final production layout while typing.',
    note: 'POST /_actions/inti.updateBlockField',
  },
  {
    title: 'Astro Server Action',
    text: 'Runs strictly on the server. Evaluates the beforeWrite plugin and authenticates the editor.',
    note: 'Credentials + who may write',
  },
  {
    title: 'WritableAdapter',
    text: "Translates the mutation into the CMS's native format (ACF array, Kitsuden UUID row, or Dynamic Zone).",
    note: 'Block normalization',
  },
  {
    title: 'Your Target CMS',
    text: 'WordPress, Kitsuden, Strapi or Keystatic saves the change where its content already lives.',
    note: 'Saved as ordinary blocks',
  },
];
---

<section id="architecture" class="field field--ink">
  <div class="dome" data-scroll></div>
  <div class="wrap">
    <h2 class="h-pair" data-scroll>
      <span class="h-display drift-l">Clean, secure architecture.</span>
      <span class="h-serif drift-r">Your credentials never touch the browser.</span>
    </h2>
    <p class="lede">Visitors get nothing from the editor, and CMS credentials stay on your server.</p>

    <ol class="route">
      <li class="route-line" data-scroll aria-hidden="true"></li>
      {
        steps.map((step, index) => (
          <li class="route-step">
            <b aria-hidden="true">0{index + 1}</b>
            <h3>{step.title}</h3>
            <p>{step.text}</p>
            <span class="mono">{step.note}</span>
          </li>
        ))
      }
    </ol>

    <ul class="rules">
      <li>
        <strong>Nothing from the editor for visitors</strong>
        In production a visitor gets the page with nothing from the editor. CI checks it for Astro 5, 6 and 7.
      </li>
      <li>
        <strong>Isolated secrets</strong>
        API tokens and application passwords never leave the server.
      </li>
      <li>
        <strong>Fail-closed in production</strong>
        A write that is not allowed is answered 403 before anything reaches your CMS.
      </li>
    </ul>
  </div>
</section>
