---
// apps/demo-site/src/components/landing/ComparisonSection.astro
// Why Inti exists: what the neighbouring tools do and do not, then the split
// slider (free-form builder vs. declared blocks).
import DesignerVsBuilderSlider from './DesignerVsBuilderSlider.astro';

const rows = [
  { tool: 'Astro Content Layer', does: 'Typed read from any source', not: 'No write path, no editing' },
  { tool: 'Keystatic', does: 'In-repo admin UI', not: 'No editing on the page (Inti adds it, with its adapter)' },
  { tool: 'TinaCMS', does: 'Visual editing', not: 'Git-based only: it does not reach your existing headless CMS' },
  { tool: 'Storyblok', does: 'Visual editing', not: 'Only on their own SaaS' },
];
---

<section id="why-inti" class="field field--paper">
  <div class="dome" data-scroll></div>
  <div class="wrap">
    <h2 class="h-pair" data-scroll>
      <span class="h-display drift-l">Why does Inti.js exist?</span>
      <span class="h-serif drift-r">The missing piece in Astro.</span>
    </h2>
    <p class="lede" style="margin-bottom: clamp(1.75rem, 3.5vw, 3rem)">
      Static site generators and modern frameworks had a major trade-off: either lock yourself into a proprietary SaaS, or settle for admin panels disconnected from the real page.
    </p>

    <table class="why-table">
      <thead>
        <tr>
          <th scope="col">Tool</th>
          <th scope="col">What it does</th>
          <th scope="col">What it does not</th>
        </tr>
      </thead>
      <tbody>
        {
          rows.map((row) => (
            <tr>
              <th scope="row">{row.tool}</th>
              <td data-label="What it does">{row.does}</td>
              <td data-label="What it does not">{row.not}</td>
            </tr>
          ))
        }
        <tr class="is-inti">
          <th scope="row">Inti.js</th>
          <td data-label="What it does">Editing on the rendered page, written back to WordPress, Kitsuden, Strapi or Keystatic. AI that composes with your blocks, and an MCP server.</td>
          <td data-label="What it does not">It is not a CMS: no admin UI, no user management, no database of its own. In beta.</td>
        </tr>
      </tbody>
    </table>

    <DesignerVsBuilderSlider />
  </div>
</section>
