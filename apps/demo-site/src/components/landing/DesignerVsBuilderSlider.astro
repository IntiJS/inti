---
// apps/demo-site/src/components/landing/DesignerVsBuilderSlider.astro
// Split slider: a free-form page builder next to declared blocks.
// Rendered inside ComparisonSection.
---

<div class="cmp">
  <h2 class="h-pair" data-scroll>
    <span class="h-display drift-l">Editors compose. The design stays in code.</span>
    <span class="h-serif drift-r">Slide to compare the two approaches.</span>
  </h2>
  <p class="lede" style="margin-bottom: clamp(1.75rem, 3.5vw, 3rem)">
    A free-form page builder lets anyone add CSS and markup to a page. Inti has no free-form CSS editing: editors work with the blocks, fields and variants your developers declared.
  </p>

  <div class="win">
    <div class="win-bar cmp-labels">
      <span>Free-form page builder</span>
      <span>Declared blocks with Inti</span>
    </div>

    <div id="split-container" class="cmp-stage">
      <!-- LEFT: free-form builder -->
      <div class="cmp-side cmp-side--free">
        <div>
          <h3>Anything can be changed, including the design</h3>
          <ul>
            <li>Editors can add arbitrary CSS and markup to a page.</li>
            <li>Fonts, spacing and layout can drift away from the design system.</li>
          </ul>
        </div>
      </div>

      <!-- RIGHT: declared blocks (clipped by the slider) -->
      <div
        id="split-overlay"
        class="cmp-side cmp-side--blocks"
        style="clip-path: polygon(50% 0, 100% 0, 100% 100%, 50% 100%);"
      >
        <div>
          <h3>Editors change the content, not the design</h3>
          <ul>
            <li><strong>Vocabulary in code:</strong> blocks, fields and variants are declared by developers.</li>
            <li><strong>Double-click and Enter:</strong> the text is saved to the CMS it came from.</li>
            <li><strong>No free-form CSS:</strong> there is nowhere to type it.</li>
            <li><strong>AI with your blocks:</strong> a model composes only with what you declared.</li>
          </ul>
        </div>
      </div>

      <!-- The divider. The knob is a slider: drag it, or focus it and use the arrow keys -->
      <div id="slider-handle" class="cmp-handle" style="left: 50%;">
        <div
          id="slider-knob"
          class="cmp-knob"
          role="slider"
          tabindex="0"
          aria-label="Comparison: how much of the free-form builder side is shown"
          aria-orientation="horizontal"
          aria-valuemin="0"
          aria-valuemax="100"
          aria-valuenow="50"
          aria-valuetext="50% free-form builder, 50% declared blocks"
        >
          <span aria-hidden="true">↔</span>
        </div>
      </div>
    </div>
  </div>

  <div class="creed">
    <blockquote>
      <p>The Inti philosophy: powerful like Oxygen, simple like Elementor.</p>
      <p>
        Developers define the component vocabulary in TypeScript and Astro code (full control and performance). Editors compose freely with that vocabulary. Because there is no free-form CSS editing, editors cannot break the design or bloat the page.
      </p>
    </blockquote>
    <a href="#features" class="btn">Explore features</a>
  </div>
</div>

<script>
  // Split slider: mouse, touch and keyboard
  const container = document.getElementById('split-container');
  const overlay = document.getElementById('split-overlay');
  const handle = document.getElementById('slider-handle');
  const knob = document.getElementById('slider-knob');

  let isDragging = false;
  let percent = 50;

  function setPercent(value: number) {
    if (!overlay || !handle) return;
    percent = Math.max(0, Math.min(100, value));
    const rounded = Math.round(percent);

    handle.style.left = `${percent}%`;
    overlay.style.clipPath = `polygon(${percent}% 0, 100% 0, 100% 100%, ${percent}% 100%)`;
    knob?.setAttribute('aria-valuenow', String(rounded));
    knob?.setAttribute('aria-valuetext', `${rounded}% free-form builder, ${100 - rounded}% declared blocks`);
  }

  function updateFromPointer(clientX: number) {
    if (!container) return;
    const rect = container.getBoundingClientRect();
    setPercent(((clientX - rect.left) / rect.width) * 100);
  }

  container?.addEventListener('mousedown', (e) => {
    isDragging = true;
    updateFromPointer(e.clientX);
  });

  window.addEventListener('mouseup', () => {
    isDragging = false;
  });

  window.addEventListener('mousemove', (e) => {
    if (isDragging) updateFromPointer(e.clientX);
  });

  container?.addEventListener('touchstart', (e) => {
    isDragging = true;
    if (e.touches[0]) updateFromPointer(e.touches[0].clientX);
  }, { passive: true });

  window.addEventListener('touchend', () => {
    isDragging = false;
  });

  window.addEventListener('touchmove', (e) => {
    if (isDragging && e.touches[0]) updateFromPointer(e.touches[0].clientX);
  }, { passive: true });

  knob?.addEventListener('keydown', (e) => {
    const step = e.shiftKey ? 10 : 5;
    if (e.key === 'ArrowLeft' || e.key === 'ArrowDown') setPercent(percent - step);
    else if (e.key === 'ArrowRight' || e.key === 'ArrowUp') setPercent(percent + step);
    else if (e.key === 'Home') setPercent(0);
    else if (e.key === 'End') setPercent(100);
    else return;
    e.preventDefault();
  });
</script>
