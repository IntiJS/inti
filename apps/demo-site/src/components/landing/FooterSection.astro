---
// apps/demo-site/src/components/landing/FooterSection.astro
import Marquee from './Marquee.astro';
import Sun from './Sun.astro';

const repo = 'https://github.com/intijs/inti';

const packages = [
  { name: '@intijs/core', path: 'packages/core' },
  { name: '@intijs/adapter-wordpress', path: 'packages/adapter-wordpress' },
  { name: '@intijs/adapter-kitsuden', path: 'packages/adapter-kitsuden' },
  { name: '@intijs/genui', path: 'packages/genui' },
  { name: '@intijs/mcp', path: 'packages/mcp' },
];
---

<section class="field field--sun closing" aria-labelledby="closing-title">
  <div class="dome" data-scroll></div>
  <div class="wrap">
    <h2 class="h-pair" id="closing-title" data-scroll>
      <span class="h-display drift-l">Move your frontend to Astro.</span>
      <span class="h-serif drift-r">Keep your CMS and your editors' admin.</span>
    </h2>
    <p class="lede">
      MIT licensed, in beta (0.1), and checked in CI against Astro 5, 6 and 7. Not on npm yet: install from git.
    </p>
    <div class="closing-buttons">
      <a href="#quickstart" class="btn">Start a project</a>
      <a href={repo} target="_blank" rel="noopener noreferrer" class="btn btn--paper">View on GitHub</a>
    </div>
  </div>

  <!-- The sun on the horizon: only its upper half shows -->
  <div class="closing-sun" data-anim aria-hidden="true">
    <Sun rays={28} ray="#FF8A00" disc="#FF3D2E" spin />
  </div>

  <Marquee items={['Open source', { serif: 'MIT' }, 'Beta', { serif: 'for Astro 5, 6 & 7' }]} />
</section>

<footer class="foot">
  <div class="wrap">
    <div class="foot-grid">
      <p class="foot-about">AI for any CMS, without changing the CMS. Built for the Astro community.</p>

      <div>
        <h3>Ecosystem</h3>
        <ul>
          <li><a href="https://astro.build" target="_blank" rel="noopener noreferrer">Astro</a></li>
          <li><a href="https://github.com/Kitsuden/kitsuden" target="_blank" rel="noopener noreferrer">Kitsuden</a></li>
          <li><a href="https://wordpress.org" target="_blank" rel="noopener noreferrer">WordPress</a></li>
          <li><a href="https://strapi.io" target="_blank" rel="noopener noreferrer">Strapi</a></li>
          <li><a href="https://keystatic.com" target="_blank" rel="noopener noreferrer">Keystatic</a></li>
        </ul>
      </div>

      <div>
        <h3>Packages</h3>
        <ul class="mono">
          {packages.map((pkg) => (
            <li><a href={`${repo}/tree/main/${pkg.path}`} target="_blank" rel="noopener noreferrer">{pkg.name}</a></li>
          ))}
        </ul>
      </div>

      <div>
        <h3>Project</h3>
        <ul>
          <li><a href={`${repo}/tree/main/apps/docs/src/content/docs`} target="_blank" rel="noopener noreferrer">Docs (on GitHub)</a></li>
          <li><a href={repo} target="_blank" rel="noopener noreferrer">GitHub repository</a></li>
          <li><a href={`${repo}/issues`} target="_blank" rel="noopener noreferrer">Issues</a></li>
          <li><a href={`${repo}/blob/main/LICENSE`} target="_blank" rel="noopener noreferrer">MIT License</a></li>
        </ul>
      </div>
    </div>

    <div class="foot-legal">
      <p>© 2026 Victor Antinori Broce. Released under the MIT License.</p>
      <p>For Astro 5, 6 &amp; 7</p>
    </div>
  </div>
  <span class="foot-word" aria-hidden="true">inti.js</span>
</footer>
