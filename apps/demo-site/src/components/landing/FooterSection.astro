---
// apps/demo-site/src/components/landing/FooterSection.astro
---

<footer class="relative overflow-hidden bg-[#05070B] border-t border-white/10 pt-20 pb-12">
  <!-- Glowing solar flare at the bottom -->
  <div class="absolute bottom-0 left-1/2 -translate-x-1/2 w-[800px] h-64 bg-gradient-to-t from-orange-500/10 via-amber-500/5 to-transparent blur-[120px] pointer-events-none"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <!-- Big CTA Banner -->
    <div class="rounded-3xl p-8 sm:p-14 bg-gradient-to-br from-[#12182B] via-[#0E1322] to-[#0A0D18] border border-white/15 shadow-2xl text-center relative overflow-hidden mb-20">
      <div class="absolute -top-20 -left-20 w-60 h-60 bg-amber-500/10 rounded-full blur-[80px] pointer-events-none"></div>
      <div class="absolute -bottom-20 -right-20 w-60 h-60 bg-rose-500/10 rounded-full blur-[80px] pointer-events-none"></div>

      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-amber-500/10 text-amber-300 border border-amber-500/20 text-xs font-semibold mb-6">
        <span>☀️ Open Source &amp; Future-Ready</span>
      </div>

      <h2 class="text-3xl sm:text-5xl font-extrabold text-white tracking-tight mb-6 max-w-2xl mx-auto leading-tight">
        Modernize your website with Astro.<br />
        <span class="text-transparent bg-clip-text bg-gradient-to-r from-amber-400 via-orange-400 to-rose-400">
          Keep your CMS and empower your editors.
        </span>
      </h2>

      <p class="text-slate-300 text-base sm:text-lg max-w-xl mx-auto mb-10">
        Start today with the official CLI. No hidden fees, MIT licensed, and compatible with Astro 5, 6, and 7.
      </p>

      <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
        <a
          href="#quickstart"
          class="px-8 py-4 rounded-xl bg-gradient-to-r from-[#FF7A00] to-[#FF0055] text-white font-bold text-sm sm:text-base shadow-xl shadow-orange-500/30 hover:shadow-orange-500/50 hover:brightness-110 active:scale-95 transition-all w-full sm:w-auto"
        >
          Start a Project with Inti.js
        </a>
        <a
          href="https://github.com/intijs/inti"
          target="_blank"
          rel="noopener noreferrer"
          class="px-6 py-4 rounded-xl bg-white/5 hover:bg-white/10 text-slate-200 font-semibold text-sm sm:text-base border border-white/10 hover:border-white/20 transition-all flex items-center justify-center gap-2 w-full sm:w-auto"
        >
          <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24">
            <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"/>
          </svg>
          <span>Star on GitHub</span>
        </a>
      </div>
    </div>

    <!-- Navigation & Links Grid -->
    <div class="grid grid-cols-2 md:grid-cols-4 gap-8 pb-12 border-b border-white/10 text-xs">
      <div class="col-span-2 md:col-span-1 space-y-3">
        <div class="flex items-center gap-2">
          <span class="w-6 h-6 rounded-lg bg-gradient-to-tr from-orange-500 to-rose-500 flex items-center justify-center text-white font-black text-xs">I</span>
          <span class="font-bold text-base text-white">inti<span class="text-orange-400">.js</span></span>
        </div>
        <p class="text-slate-400 leading-relaxed">
          AI for any CMS, without changing the CMS. Built for the Astro community.
        </p>
      </div>

      <div>
        <h4 class="font-bold text-slate-200 mb-3 uppercase tracking-wider text-[11px]">Ecosystem</h4>
        <ul class="space-y-2 text-slate-400">
          <li><a href="https://astro.build" target="_blank" class="hover:text-white transition-colors">Astro</a></li>
          <li><a href="https://github.com/Victor-Antinori-Broce/kitsuden" target="_blank" class="hover:text-white transition-colors">Kitsuden CMS</a></li>
          <li><a href="https://wordpress.org" target="_blank" class="hover:text-white transition-colors">WordPress ACF</a></li>
          <li><a href="https://strapi.io" target="_blank" class="hover:text-white transition-colors">Strapi</a></li>
          <li><a href="https://keystatic.com" target="_blank" class="hover:text-white transition-colors">Keystatic</a></li>
        </ul>
      </div>

      <div>
        <h4 class="font-bold text-slate-200 mb-3 uppercase tracking-wider text-[11px]">Packages</h4>
        <ul class="space-y-2 text-slate-400 font-mono text-[11px]">
          <li><a href="#adapters" class="hover:text-white transition-colors">@intijs/core</a></li>
          <li><a href="#adapters" class="hover:text-white transition-colors">@intijs/adapter-wordpress</a></li>
          <li><a href="#adapters" class="hover:text-white transition-colors">@intijs/adapter-kitsuden</a></li>
          <li><a href="#adapters" class="hover:text-white transition-colors">@intijs/genui</a></li>
          <li><a href="#adapters" class="hover:text-white transition-colors">@intijs/mcp</a></li>
        </ul>
      </div>

      <div>
        <h4 class="font-bold text-slate-200 mb-3 uppercase tracking-wider text-[11px]">Community</h4>
        <ul class="space-y-2 text-slate-400">
          <li><a href="https://github.com/intijs/inti" target="_blank" class="hover:text-white transition-colors">GitHub Repository</a></li>
          <li><a href="https://github.com/intijs/inti/issues" target="_blank" class="hover:text-white transition-colors">Issues &amp; Roadmap</a></li>
          <li><a href="https://github.com/intijs/inti/blob/main/LICENSE" target="_blank" class="hover:text-white transition-colors">MIT License</a></li>
        </ul>
      </div>
    </div>

    <!-- Bottom Copyright -->
    <div class="pt-8 flex flex-col sm:flex-row items-center justify-between text-xs text-slate-500 gap-4">
      <p>© 2026 Victor Antinori Broce · Released under the MIT License.</p>
      <div class="flex items-center gap-4">
        <span>Built for Astro 5, 6 &amp; 7</span>
        <span class="w-1 h-1 rounded-full bg-slate-700"></span>
        <span class="text-amber-400/80 font-mono">☀️ Inti.js</span>
      </div>
    </div>
  </div>
</footer>
