---
// apps/demo-site/src/components/landing/HeroSection.astro
import SolarCanvas3D from './SolarCanvas3D.astro';
---

<section class="relative pt-32 pb-20 sm:pt-44 sm:pb-32 overflow-hidden">
  <!-- Interactive 3D Solar Gyroscope Canvas -->
  <SolarCanvas3D />

  <!-- Background Glow & Cyber Grid -->
  <div class="absolute inset-0 bg-[radial-gradient(ellipse_80%_80%_at_50%_-20%,rgba(255,122,0,0.15),rgba(255,255,255,0))] pointer-events-none -z-10"></div>
  <div class="absolute top-1/3 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[700px] h-[450px] bg-gradient-to-tr from-[#FF7A00]/20 via-[#FF0055]/15 to-[#7928CA]/20 blur-[130px] rounded-full pointer-events-none -z-10"></div>

  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 text-center relative z-10">
    <!-- Audience Badge: Designers + Marketers + Developers -->
    <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-white/5 border border-white/10 text-xs sm:text-sm text-slate-200 backdrop-blur-md mb-8 hover:border-amber-500/40 transition-all cursor-pointer group shadow-lg">
      <span class="flex h-2 w-2 relative">
        <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-amber-400 opacity-75"></span>
        <span class="relative inline-flex rounded-full h-2 w-2 bg-amber-500"></span>
      </span>
      <span class="font-medium text-slate-300">For Designers who love Figma</span>
      <span class="text-slate-500">·</span>
      <span class="text-amber-300 font-semibold group-hover:text-amber-200 transition-colors">For Marketers who demand speed</span>
      <span class="text-slate-500">·</span>
      <span class="text-rose-400 font-semibold">For Astro Devs</span>
    </div>

    <!-- Main Headline with 3D feel -->
    <h1 class="text-4xl sm:text-6xl lg:text-7xl font-extrabold tracking-tight text-white leading-[1.1] mb-6">
      Figma-Faithful Design.<br class="hidden sm:inline" />
      Live Editing for <span class="text-transparent bg-clip-text bg-gradient-to-r from-orange-400 via-rose-500 to-purple-400">Marketing</span>.<br />
      <span class="relative">
        <span class="text-transparent bg-clip-text bg-gradient-to-r from-amber-300 via-orange-400 to-rose-400">Your CMS untouched</span>
        <svg class="absolute -bottom-2 left-0 right-0 w-full h-3 text-orange-500/60" viewBox="0 0 300 12" fill="none" preserveAspectRatio="none">
          <path d="M1 9C60 3 140 3 299 9" stroke="currentColor" stroke-width="3" stroke-linecap="round"/>
        </svg>
      </span>
      at Astro speed.
    </h1>

    <!-- Subtitle / Pain-killer Value Prop -->
    <p class="max-w-3xl mx-auto text-base sm:text-xl text-slate-300 font-normal leading-relaxed mb-10">
      Forget clients breaking fonts with Elementor or two-week engineering tickets just to change a headline. With <strong class="text-white font-semibold">Inti.js</strong>, marketing edits with a double-click on the real page and composes with AI, while your design system stays 100% unbreakable on top of WordPress, Kitsuden, Strapi, or Keystatic.
    </p>

    <!-- CTAs & CLI Quick Copy -->
    <div class="flex flex-col sm:flex-row items-center justify-center gap-4 mb-16">
      <!-- 1-Click CLI Box with Glowing Conic Border -->
      <div class="relative p-[1px] rounded-xl bg-gradient-to-r from-amber-500 via-rose-500 to-purple-500 shadow-xl group">
        <div class="flex items-center gap-2 px-4 py-2.5 rounded-[11px] bg-[#0A0D18] text-slate-200 font-mono text-sm w-full sm:w-auto justify-between sm:justify-start">
          <div class="flex items-center gap-2.5">
            <span class="text-amber-400 select-none font-bold">$</span>
            <span class="text-slate-100 select-all font-semibold" id="cli-command">npm create inti@latest</span>
          </div>
          <button
            type="button"
            id="copy-cli-btn"
            class="ml-2 p-1.5 rounded-lg bg-white/5 hover:bg-white/10 text-slate-400 hover:text-white transition-all text-xs flex items-center gap-1 active:scale-95"
            title="Copy command to clipboard"
          >
            <svg class="w-4 h-4" id="copy-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"/>
            </svg>
            <span id="copy-text">Copy</span>
          </button>
        </div>
      </div>

      <!-- Live Demo Button -->
      <a
        href="#interactive-demo"
        class="inline-flex items-center justify-center gap-2 px-7 py-3 rounded-xl bg-gradient-to-r from-[#FF7A00] to-[#FF0055] text-white font-bold text-sm shadow-xl shadow-orange-500/30 hover:shadow-orange-500/50 hover:brightness-110 active:scale-95 transition-all w-full sm:w-auto"
      >
        <span>Try Interactive Simulator</span>
        <svg class="w-4 h-4 animate-bounce" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3"/>
        </svg>
      </a>

      <!-- Exploded 3D Architecture Link -->
      <a
        href="#architecture-3d"
        class="inline-flex items-center justify-center gap-2 px-5 py-3 rounded-xl bg-white/5 hover:bg-white/10 text-slate-200 font-semibold text-sm border border-white/10 hover:border-white/20 transition-all w-full sm:w-auto"
      >
        <span>View 3D Stack</span>
        <svg class="w-4 h-4 text-cyan-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/>
        </svg>
      </a>
    </div>

    <!-- 4 High-Impact KPI Badges for Designers & Marketers -->
    <div class="grid grid-cols-2 md:grid-cols-4 gap-4 max-w-4xl mx-auto pt-6 border-t border-white/10 text-left">
      <!-- KPI 1 -->
      <div class="p-4 rounded-xl bg-white/[0.02] border border-white/5 hover:border-amber-500/30 transition-all">
        <span class="text-2xl font-black text-amber-400 font-mono">100/100</span>
        <h4 class="text-white text-xs font-bold mt-1">Core Web Vitals</h4>
        <p class="text-[11px] text-slate-400 mt-0.5">Zero editor JS shipped to visitors. Instant load.</p>
      </div>

      <!-- KPI 2 -->
      <div class="p-4 rounded-xl bg-white/[0.02] border border-white/5 hover:border-cyan-500/30 transition-all">
        <span class="text-2xl font-black text-cyan-400 font-mono">100%</span>
        <h4 class="text-white text-xs font-bold mt-1">Figma-to-Code</h4>
        <p class="text-[11px] text-slate-400 mt-0.5">Typed components. Impossible to break styles.</p>
      </div>

      <!-- KPI 3 -->
      <div class="p-4 rounded-xl bg-white/[0.02] border border-white/5 hover:border-purple-500/30 transition-all">
        <span class="text-2xl font-black text-purple-400 font-mono">0 Days</span>
        <h4 class="text-white text-xs font-bold mt-1">Data Migration</h4>
        <p class="text-[11px] text-slate-400 mt-0.5">Keep your existing CMS database and users.</p>
      </div>

      <!-- KPI 4 -->
      <div class="p-4 rounded-xl bg-white/[0.02] border border-white/5 hover:border-rose-500/30 transition-all">
        <span class="text-2xl font-black text-rose-400 font-mono">MCP + AI</span>
        <h4 class="text-white text-xs font-bold mt-1">Generative UI</h4>
        <p class="text-[11px] text-slate-400 mt-0.5">Campaign composition with your own brand blocks.</p>
      </div>
    </div>
  </div>
</section>

<script>
  // Copy CLI command logic
  const copyBtn = document.getElementById('copy-cli-btn');
  const copyText = document.getElementById('copy-text');
  const commandText = 'npm create inti@latest';

  copyBtn?.addEventListener('click', async () => {
    try {
      await navigator.clipboard.writeText(commandText);
      if (copyText) {
        copyText.textContent = 'Copied!';
        copyBtn.classList.add('text-emerald-400');
        setTimeout(() => {
          copyText.textContent = 'Copy';
          copyBtn.classList.remove('text-emerald-400');
        }, 2000);
      }
    } catch (e) {
      console.warn('Clipboard write failed', e);
    }
  });
</script>
