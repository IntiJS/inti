---
// apps/demo-site/src/components/landing/HeroSection.astro
import SolarCanvas3D from './SolarCanvas3D.astro';
---

<section class="relative pt-32 pb-20 sm:pt-44 sm:pb-32 overflow-hidden">
  <!-- Decorative canvas (paused off-screen and under reduced motion) -->
  <SolarCanvas3D />

  <!-- Background Glow & Cyber Grid -->
  <div class="absolute inset-0 bg-[radial-gradient(ellipse_80%_80%_at_50%_-20%,rgba(255,122,0,0.15),rgba(255,255,255,0))] pointer-events-none -z-10"></div>
  <div class="absolute top-1/3 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[700px] h-[450px] bg-gradient-to-tr from-[#FF7A00]/20 via-[#FF0055]/15 to-[#7928CA]/20 blur-[130px] rounded-full pointer-events-none -z-10"></div>

  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 text-center relative z-10">
    <!-- Status badge -->
    <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-white/5 border border-white/10 text-xs sm:text-sm text-slate-200 backdrop-blur-md mb-8 shadow-lg">
      <span class="relative inline-flex rounded-full h-2 w-2 bg-amber-500"></span>
      <span class="font-medium text-slate-300">Beta 0.1</span>
      <span class="text-slate-500">·</span>
      <span class="text-amber-300 font-semibold">MIT</span>
      <span class="text-slate-500">·</span>
      <span class="text-slate-300 font-medium">For Astro sites</span>
    </div>

    <!-- Main Headline -->
    <h1 class="text-4xl sm:text-5xl lg:text-6xl font-extrabold tracking-tight text-white leading-[1.1] mb-6">
      Edit your Astro site on the page.<br class="hidden sm:inline" />
      It saves back to the CMS you already have.
    </h1>

    <!-- Lede -->
    <p class="max-w-3xl mx-auto text-base sm:text-xl text-slate-300 font-normal leading-relaxed mb-10">
      <strong class="text-white font-semibold">Inti.js</strong> is an open-source layer for Astro sites, whether you write them by hand or with a coding agent. Double-click a text on the rendered page and the change is written to WordPress, Kitsuden, Strapi or Keystatic. A model composes sections from the blocks you declared, and agents edit the same content through an MCP server.
    </p>

    <!-- CTAs & copyable first command -->
    <div class="flex flex-col sm:flex-row items-center justify-center gap-4 mb-4">
      <div class="relative p-[1px] rounded-xl bg-gradient-to-r from-amber-500 via-rose-500 to-purple-500 shadow-xl group w-full sm:w-auto">
        <div class="flex items-center gap-2 px-4 py-2.5 rounded-[11px] bg-[#0A0D18] text-slate-200 font-mono text-xs sm:text-sm w-full sm:w-auto justify-between sm:justify-start">
          <div class="flex items-center gap-2.5 min-w-0">
            <span class="text-amber-400 select-none font-bold">$</span>
            <span class="text-slate-100 select-all font-semibold truncate" id="cli-command">git clone https://github.com/intijs/inti.git</span>
          </div>
          <button
            type="button"
            id="copy-cli-btn"
            class="ml-2 p-1.5 rounded-lg bg-white/5 hover:bg-white/10 text-slate-400 hover:text-white transition-all text-xs flex items-center gap-1 active:scale-95"
            aria-label="Copy the git clone command"
          >
            <svg class="w-4 h-4" id="copy-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"/>
            </svg>
            <span id="copy-text">Copy</span>
          </button>
        </div>
      </div>

      <a
        href="#quickstart"
        class="inline-flex items-center justify-center gap-2 px-7 py-3 rounded-xl bg-gradient-to-r from-[#FF7A00] to-[#FF0055] text-white font-bold text-sm shadow-xl shadow-orange-500/30 hover:shadow-orange-500/50 hover:brightness-110 active:scale-95 transition-all w-full sm:w-auto"
      >
        <span>Quickstart</span>
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3"/>
        </svg>
      </a>

      <a
        href="https://github.com/intijs/inti/tree/main/apps/docs/src/content/docs"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center justify-center gap-2 px-5 py-3 rounded-xl bg-white/5 hover:bg-white/10 text-slate-200 font-semibold text-sm border border-white/10 hover:border-white/20 transition-all w-full sm:w-auto"
      >
        <span>Docs on GitHub</span>
        <svg class="w-4 h-4 text-cyan-400" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/>
        </svg>
      </a>
    </div>

    <p class="text-xs sm:text-sm text-slate-400 mb-16">
      Not on npm yet: the packages will be published under <code class="font-mono text-slate-300">@intijs</code>. Until then, install from git. The <a href="#quickstart" class="underline hover:text-white">Quickstart</a> has the commands.
    </p>

    <!-- Four facts, each one checkable in the repository -->
    <div class="grid grid-cols-2 md:grid-cols-4 gap-4 max-w-4xl mx-auto pt-6 border-t border-white/10 text-left">
      <div class="p-4 rounded-xl bg-white/[0.02] border border-white/5 hover:border-amber-500/30 transition-all">
        <span class="text-2xl font-black text-amber-400 font-mono">4 CMSs</span>
        <h2 class="text-white text-xs font-bold mt-1">Read and write back</h2>
        <p class="text-[11px] text-slate-400 mt-0.5">WordPress, Kitsuden, Strapi and Keystatic. Contentful and Sanity are read-only.</p>
      </div>

      <div class="p-4 rounded-xl bg-white/[0.02] border border-white/5 hover:border-cyan-500/30 transition-all">
        <span class="text-2xl font-black text-cyan-400 font-mono">Astro 5·6·7</span>
        <h2 class="text-white text-xs font-bold mt-1">Each major checked in CI</h2>
        <p class="text-[11px] text-slate-400 mt-0.5">A clean project is installed, built and served for every major on every push.</p>
      </div>

      <div class="p-4 rounded-xl bg-white/[0.02] border border-white/5 hover:border-purple-500/30 transition-all">
        <span class="text-2xl font-black text-purple-400 font-mono">13 tools</span>
        <h2 class="text-white text-xs font-bold mt-1">MCP server for agents</h2>
        <p class="text-[11px] text-slate-400 mt-0.5">Read, edit, insert, move and draft. INTI_MCP_READONLY=1 drops the write tools.</p>
      </div>

      <div class="p-4 rounded-xl bg-white/[0.02] border border-white/5 hover:border-rose-500/30 transition-all">
        <span class="text-2xl font-black text-rose-400 font-mono">MIT</span>
        <h2 class="text-white text-xs font-bold mt-1">Every package</h2>
        <p class="text-[11px] text-slate-400 mt-0.5">Open source and in beta: the APIs may still change before 1.0.</p>
      </div>
    </div>
  </div>
</section>

<script>
  // Copy the first command
  const copyBtn = document.getElementById('copy-cli-btn');
  const copyText = document.getElementById('copy-text');
  const commandText = 'git clone https://github.com/intijs/inti.git';

  copyBtn?.addEventListener('click', async () => {
    try {
      await navigator.clipboard.writeText(commandText);
      if (copyText) {
        copyText.textContent = 'Copied!';
        copyBtn.classList.add('text-emerald-400');
        setTimeout(() => {
          copyText.textContent = 'Copy';
          copyBtn.classList.remove('text-emerald-400');
        }, 2000);
      }
    } catch (e) {
      console.warn('Clipboard write failed', e);
    }
  });
</script>
