---
// apps/demo-site/src/components/landing/InteractiveEditorDemo.astro
// A simulation of the editor that runs only in the browser. Nothing is sent
// anywhere: the panel on the right shows the input the real action receives.
---

<section id="interactive-demo" class="field field--orange">
  <div class="dome" data-scroll></div>

  <!-- The three gestures, as type that moves with the scroll -->
  <div class="giant" data-scroll aria-hidden="true">
    <span>Double-click.</span>
    <span>Type. Enter.</span>
  </div>

  <div class="wrap">
    <div class="demo-head">
      <h2 class="h-pair" data-scroll>
        <span class="h-display drift-l">What editing on the page looks like.</span>
        <span class="h-serif drift-r">Change the text and see what would be saved.</span>
      </h2>
      <p><span class="sim">Simulated: nothing is sent</span></p>
      <p class="lede">
        This is a simulation that runs only in your browser, with sample content. In a real project the editor calls an <code class="kbd-code">astro:actions</code> endpoint on your server, and the adapter writes the change to your CMS.
      </p>
    </div>

    <div class="win" id="demo-mockup-window">
      <div class="win-bar">
        <span class="win-field">
          <span class="win-dots" aria-hidden="true"><i></i><i></i><i></i></span>
          <span class="win-url">https://example.com/ [simulation]</span>
        </span>

        <span class="seg">
          <button type="button" id="btn-mode-visitor" aria-pressed="false">Visitor view</button>
          <button type="button" id="btn-mode-editor" aria-pressed="true">Editor view</button>
        </span>

        <span class="win-field">
          <label for="cms-select">Adapter:</label>
          <select id="cms-select" class="sel">
            <option value="wordpress">WordPress (ACF Flexible Content)</option>
            <option value="kitsuden">Kitsuden (Page Builder)</option>
            <option value="strapi">Strapi (dynamic zone)</option>
            <option value="keystatic">Keystatic (files)</option>
          </select>
        </span>
      </div>

      <div class="demo-grid">
        <!-- The rendered page -->
        <div class="demo-canvas">
          <div id="editor-banner" class="demo-banner">
            <span><strong>Simulated editor:</strong> click an outlined text and type. The real editor opens a field with a double-click.</span>
            <button type="button" id="undo-btn" class="btn btn--small">Undo</button>
          </div>

          <div id="interactive-block" class="demo-block" data-variant="warm">
            <span id="block-toolbar" class="demo-block-tag">HeroBanner, sample content</span>

            <div class="demo-field">
              <span class="field-label">data-inti-field="heading"</span>
              <h3 id="demo-heading" class="demo-edit demo-h" contenteditable="true" role="textbox" aria-label="Sample heading" spellcheck="false">Fresh bread every morning</h3>
            </div>

            <div class="demo-field">
              <span class="field-label">data-inti-field="subheading"</span>
              <p id="demo-subheading" class="demo-edit demo-sub" contenteditable="true" role="textbox" aria-label="Sample subheading" spellcheck="false">Sample text for a made-up bakery. Click here and type to change it.</p>
            </div>

            <div class="demo-foot">
              <div class="demo-field">
                <span class="field-label">data-inti-field="cta.label"</span>
                <span id="demo-cta" class="demo-edit demo-cta" contenteditable="true" role="textbox" aria-label="Sample button label" spellcheck="false">See the menu</span>
              </div>

              <div class="demo-variant">
                <label for="demo-variant-select">Variant:</label>
                <select id="demo-variant-select" class="sel">
                  <option value="warm">warm</option>
                  <option value="dark">dark</option>
                  <option value="purple">purple</option>
                </select>
              </div>
            </div>
          </div>

          <p class="demo-note">In the real editor the text changes on screen at once and reverts if the save fails.</p>
        </div>

        <!-- What the editor would send -->
        <div class="demo-inspector">
          <div>
            <h3>What the editor would send <span>Simulated, not sent</span></h3>

            <dl class="demo-kv">
              <div><dt>Action:</dt><dd id="inspector-action">inti.updateBlockField</dd></div>
              <div><dt>Written by:</dt><dd id="inspector-target">@intijs/adapter-wordpress</dd></div>
              <div><dt>Credentials:</dt><dd>stay on your server</dd></div>
            </dl>

            <p class="demo-json-label">Input of the action (example ids):</p>
            <pre id="json-payload-display" class="demo-json" aria-live="polite"></pre>
          </div>

          <div class="demo-secure">
            <strong>Refused by default in production</strong>
            In production Inti rejects every write unless a plugin you register decides who is editing. WordPress passwords and Kitsuden agent keys live only on the Astro server.
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  // Simulator logic. Nothing here talks to a server.
  const headingEl = document.getElementById('demo-heading');
  const subheadingEl = document.getElementById('demo-subheading');
  const ctaEl = document.getElementById('demo-cta');
  const variantSelect = document.getElementById('demo-variant-select') as HTMLSelectElement | null;
  const cmsSelect = document.getElementById('cms-select') as HTMLSelectElement | null;
  const jsonDisplay = document.getElementById('json-payload-display');
  const inspectorAction = document.getElementById('inspector-action');
  const inspectorTarget = document.getElementById('inspector-target');
  const blockEl = document.getElementById('interactive-block');
  const blockToolbar = document.getElementById('block-toolbar');
  const editorBanner = document.getElementById('editor-banner');
  const btnVisitor = document.getElementById('btn-mode-visitor');
  const btnEditor = document.getElementById('btn-mode-editor');
  const undoBtn = document.getElementById('undo-btn');

  type State = { heading: string; subheading: string; cta: string; variant: string };

  // Example document ids, in the shape each adapter uses
  const CMS: Record<string, { adapter: string; documentId: string }> = {
    wordpress: { adapter: '@intijs/adapter-wordpress', documentId: '42' },
    kitsuden: { adapter: '@intijs/adapter-kitsuden', documentId: '11111111-2222-3333-4444-555555555555' },
    strapi: { adapter: '@intijs/adapter-strapi', documentId: 'abc123' },
    keystatic: { adapter: '@intijs/adapter-keystatic', documentId: 'home' },
  };

  let editing = true;
  let last = { field: 'heading', value: headingEl?.textContent?.trim() ?? '' };
  const history: State[] = [];

  function readState(): State {
    return {
      heading: headingEl?.textContent ?? '',
      subheading: subheadingEl?.textContent ?? '',
      cta: ctaEl?.textContent ?? '',
      variant: variantSelect?.value ?? 'warm',
    };
  }

  function saveState() {
    history.push(readState());
    if (history.length > 20) history.shift();
  }

  function paintBlock() {
    if (!blockEl) return;
    blockEl.dataset.variant = variantSelect?.value ?? 'warm';
    blockEl.classList.toggle('is-visitor', !editing);
  }

  // The input of `inti.updateBlockField`, as the real action declares it
  function showInput(field: string, value: string) {
    last = { field, value };
    const cms = CMS[cmsSelect?.value ?? 'wordpress'] ?? CMS.wordpress;
    if (inspectorAction) inspectorAction.textContent = 'inti.updateBlockField';
    if (inspectorTarget) inspectorTarget.textContent = cms.adapter;
    if (jsonDisplay) {
      jsonDisplay.textContent = JSON.stringify({ documentId: cms.documentId, blockIndex: 0, field, value }, null, 2);
    }
  }

  saveState();
  paintBlock();
  showInput(last.field, last.value);

  let debounceTimer: ReturnType<typeof setTimeout> | undefined;
  function handleInput(field: string, element: HTMLElement | null) {
    if (!element) return;
    clearTimeout(debounceTimer);
    debounceTimer = setTimeout(() => {
      saveState();
      showInput(field, (element.textContent ?? '').trim());
    }, 200);
  }

  headingEl?.addEventListener('input', () => handleInput('heading', headingEl));
  subheadingEl?.addEventListener('input', () => handleInput('subheading', subheadingEl));
  ctaEl?.addEventListener('input', () => handleInput('cta.label', ctaEl));

  // The sample fields are single lines: Enter leaves the field instead of adding a line break
  for (const el of [headingEl, subheadingEl, ctaEl]) {
    el?.addEventListener('keydown', (event) => {
      if (event.key === 'Enter') {
        event.preventDefault();
        el.blur();
      }
    });
    el?.addEventListener('paste', (event) => {
      event.preventDefault();
      const text = event.clipboardData?.getData('text/plain').replace(/\s+/g, ' ') ?? '';
      const selection = window.getSelection();
      if (!selection?.rangeCount) return;
      const range = selection.getRangeAt(0);
      range.deleteContents();
      range.insertNode(document.createTextNode(text));
      range.collapse(false);
      el.dispatchEvent(new Event('input', { bubbles: true }));
    });
  }

  variantSelect?.addEventListener('change', () => {
    saveState();
    paintBlock();
    showInput('variant', variantSelect.value);
  });

  cmsSelect?.addEventListener('change', () => showInput(last.field, last.value));

  undoBtn?.addEventListener('click', () => {
    if (history.length < 2) return;
    history.pop();
    const prev = history[history.length - 1];
    if (!prev || !headingEl || !subheadingEl || !ctaEl || !variantSelect) return;
    headingEl.textContent = prev.heading;
    subheadingEl.textContent = prev.subheading;
    ctaEl.textContent = prev.cta;
    variantSelect.value = prev.variant;
    paintBlock();
    showInput('heading', prev.heading.trim());
  });

  // Visitor / editor view
  function setEditing(next: boolean) {
    editing = next;
    btnEditor?.setAttribute('aria-pressed', String(next));
    btnVisitor?.setAttribute('aria-pressed', String(!next));
    if (blockToolbar) blockToolbar.hidden = !next;
    if (editorBanner) editorBanner.hidden = !next;
    document.querySelectorAll<HTMLElement>('.field-label').forEach((el) => { el.hidden = !next; });
    for (const el of [headingEl, subheadingEl, ctaEl]) {
      el?.setAttribute('contenteditable', String(next));
      if (next) el?.setAttribute('role', 'textbox');
      else el?.removeAttribute('role');
    }
    paintBlock();
  }

  btnVisitor?.addEventListener('click', () => setEditing(false));
  btnEditor?.addEventListener('click', () => setEditing(true));
</script>
