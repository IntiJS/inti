---
// apps/demo-site/src/components/landing/InteractiveEditorDemo.astro
// A simulation of the editor that runs only in the browser. Nothing is sent
// anywhere: the panel on the right shows the input the real action receives.
---

<section id="interactive-demo" class="py-20 sm:py-28 relative overflow-hidden bg-[#07090E]/90 border-y border-white/10">
  <!-- Glow orbs -->
  <div class="absolute -top-32 right-10 w-96 h-96 bg-orange-500/10 rounded-full blur-[100px] pointer-events-none"></div>
  <div class="absolute -bottom-32 left-10 w-96 h-96 bg-purple-500/10 rounded-full blur-[100px] pointer-events-none"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Section Header -->
    <div class="text-center max-w-3xl mx-auto mb-14">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-emerald-500/10 text-emerald-300 border border-emerald-500/20 text-xs font-semibold mb-4">
        <span class="w-2 h-2 rounded-full bg-emerald-400"></span>
        Simulated: nothing is sent
      </div>
      <h2 class="text-3xl sm:text-5xl font-extrabold text-white tracking-tight mb-4">
        What editing on the page looks like.<br />
        <span class="text-transparent bg-clip-text bg-gradient-to-r from-amber-400 via-orange-400 to-rose-400">
          Change the text and see what would be saved.
        </span>
      </h2>
      <p class="text-slate-300 text-base sm:text-lg">
        This is a simulation that runs only in your browser, with sample content. In a real project the editor calls an <code class="text-amber-300 font-mono text-sm bg-white/5 px-2 py-0.5 rounded">astro:actions</code> endpoint on your server, and the adapter writes the change to your CMS.
      </p>
    </div>

    <!-- Simulator mockup -->
    <div
      id="demo-mockup-window"
      class="rounded-2xl border border-white/15 bg-[#0C101C] shadow-2xl overflow-hidden backdrop-blur-xl relative transition-transform duration-150 ease-out transform-gpu"
    >
      <!-- Light reflection following the mouse cursor (off under reduced motion) -->
      <div id="mockup-specular" class="absolute inset-0 pointer-events-none opacity-0 transition-opacity duration-300 z-30"></div>
      <!-- Top Window Header Bar -->
      <div class="px-4 py-3 bg-[#090C16] border-b border-white/10 flex flex-wrap items-center justify-between gap-4">
        <!-- Window Controls & URL bar -->
        <div class="flex items-center gap-3">
          <div class="flex items-center gap-1.5" aria-hidden="true">
            <span class="w-3 h-3 rounded-full bg-rose-500/80"></span>
            <span class="w-3 h-3 rounded-full bg-amber-500/80"></span>
            <span class="w-3 h-3 rounded-full bg-emerald-500/80"></span>
          </div>
          <div class="hidden sm:flex items-center gap-2 px-3 py-1 rounded-lg bg-black/40 border border-white/5 text-xs text-slate-400 font-mono">
            <span>https://example.com/</span>
            <span class="text-amber-400 font-semibold">[simulation]</span>
          </div>
        </div>

        <!-- Mode Toggle Switch (Visitor vs Editor) -->
        <div class="flex items-center gap-2 bg-[#14192A] p-1 rounded-xl border border-white/10">
          <button
            type="button"
            id="btn-mode-visitor"
            aria-pressed="false"
            class="px-3 py-1.5 rounded-lg text-xs font-semibold text-slate-400 hover:text-white transition-all"
          >
            Visitor view
          </button>
          <button
            type="button"
            id="btn-mode-editor"
            aria-pressed="true"
            class="px-3 py-1.5 rounded-lg text-xs font-semibold bg-gradient-to-r from-amber-500 to-orange-500 text-white shadow-md transition-all"
          >
            Editor view
          </button>
        </div>

        <!-- Target CMS Selector -->
        <div class="flex items-center gap-1.5">
          <label for="cms-select" class="text-xs text-slate-400 font-medium hidden md:inline">Adapter:</label>
          <select
            id="cms-select"
            class="bg-[#14192A] text-slate-200 text-xs font-semibold rounded-lg px-2.5 py-1.5 border border-white/10 focus-visible:outline focus-visible:outline-2 focus-visible:outline-amber-400 cursor-pointer"
          >
            <option value="wordpress">WordPress (ACF Flexible Content)</option>
            <option value="kitsuden">Kitsuden (Page Builder)</option>
            <option value="strapi">Strapi (dynamic zone)</option>
            <option value="keystatic">Keystatic (files)</option>
          </select>
        </div>
      </div>

      <!-- Main Canvas & Inspector Grid -->
      <div class="grid grid-cols-1 lg:grid-cols-12 min-h-[480px]">
        <!-- Left: Rendered Page Canvas (7 cols) -->
        <div class="lg:col-span-7 p-6 sm:p-8 flex flex-col justify-between relative bg-gradient-to-b from-[#0C101C] to-[#0A0D17]">
          <!-- Editor Status Ribbon -->
          <div id="editor-banner" class="mb-6 flex items-center justify-between p-3 rounded-xl bg-amber-500/10 border border-amber-500/20 text-amber-200 text-xs">
            <div class="flex items-center gap-2">
              <span class="w-2 h-2 rounded-full bg-amber-400"></span>
              <span><strong>Simulated editor:</strong> click an outlined text and type. The real editor opens a field with a double-click.</span>
            </div>
            <button type="button" id="undo-btn" class="px-2 py-1 rounded bg-white/10 hover:bg-white/20 text-white font-mono text-[11px] transition-all">
              ↺ Undo
            </button>
          </div>

          <!-- The Rendered Block Component -->
          <div
            id="interactive-block"
            class="relative rounded-2xl p-6 sm:p-8 transition-all duration-300 border-2 border-dashed border-amber-500/40 bg-slate-900/60 shadow-xl group/block"
          >
            <!-- Block type label -->
            <div id="block-toolbar" class="absolute -top-4 left-6 flex items-center gap-1 bg-[#1A2035] border border-amber-500/40 rounded-lg px-2 py-1 shadow-lg text-xs text-slate-300 z-20">
              <span class="text-[10px] uppercase font-bold text-amber-400 tracking-wider">HeroBanner · sample content</span>
            </div>

            <!-- Block Field: Heading -->
            <div class="mb-4 relative group/field">
              <span class="field-label text-[10px] font-mono text-amber-400/80 bg-black/60 px-1.5 py-0.5 rounded absolute -top-5 left-0">
                data-inti-field="heading"
              </span>
              <h3
                id="demo-heading"
                contenteditable="true"
                class="text-2xl sm:text-4xl font-extrabold text-white tracking-tight focus:outline-none focus:ring-2 focus:ring-amber-400/80 rounded-lg p-2 transition-all bg-white/[0.02] hover:bg-white/[0.05]"
              >
                Fresh bread every morning
              </h3>
            </div>

            <!-- Block Field: Subheading -->
            <div class="mb-6 relative group/field">
              <span class="field-label text-[10px] font-mono text-amber-400/80 bg-black/60 px-1.5 py-0.5 rounded absolute -top-5 left-0">
                data-inti-field="subheading"
              </span>
              <p
                id="demo-subheading"
                contenteditable="true"
                class="text-slate-300 text-sm sm:text-base leading-relaxed focus:outline-none focus:ring-2 focus:ring-amber-400/80 rounded-lg p-2 transition-all bg-white/[0.02] hover:bg-white/[0.05]"
              >
                Sample text for a made-up bakery. Click here and type to change it.
              </p>
            </div>

            <!-- Block Controls: CTA & Variant selector -->
            <div class="flex flex-wrap items-center gap-4 pt-4 border-t border-white/10">
              <div class="relative group/field">
                <span class="field-label text-[10px] font-mono text-amber-400/80 bg-black/60 px-1.5 py-0.5 rounded absolute -top-5 left-0">
                  data-inti-field="cta.label"
                </span>
                <span
                  id="demo-cta"
                  contenteditable="true"
                  class="inline-block px-4 py-2 rounded-lg bg-gradient-to-r from-orange-500 to-rose-500 text-white font-semibold text-xs sm:text-sm focus:outline-none focus:ring-2 focus:ring-amber-300 transition-all cursor-text"
                >
                  See the menu
                </span>
              </div>

              <!-- Variant dropdown simulation -->
              <div class="flex items-center gap-2 text-xs text-slate-400 ml-auto">
                <label for="demo-variant-select">Variant:</label>
                <select
                  id="demo-variant-select"
                  class="bg-[#14192A] text-slate-200 text-xs font-medium rounded-md px-2 py-1 border border-white/15 focus-visible:outline focus-visible:outline-2 focus-visible:outline-amber-400"
                >
                  <option value="warm">warm</option>
                  <option value="dark">dark</option>
                  <option value="purple">purple</option>
                </select>
              </div>
            </div>
          </div>

          <!-- Bottom Notice -->
          <div class="mt-6 text-xs text-slate-400">
            In the real editor the text changes on screen at once and reverts if the save fails.
          </div>
        </div>

        <!-- Right: what the editor would send (5 cols) -->
        <div class="lg:col-span-5 bg-[#080B14] p-6 border-t lg:border-t-0 lg:border-l border-white/10 flex flex-col justify-between font-mono">
          <div>
            <!-- Inspector Header -->
            <div class="flex items-center justify-between pb-3 mb-4 border-b border-white/10 text-xs">
              <span class="text-white font-semibold uppercase tracking-wider">What the editor would send</span>
              <span class="px-2 py-0.5 rounded bg-amber-500/20 text-amber-300 text-[10px] font-bold">
                Simulated · not sent
              </span>
            </div>

            <!-- Action Endpoint details -->
            <div class="space-y-2 mb-4 text-xs">
              <div class="flex items-center justify-between gap-3 text-slate-400">
                <span>Action:</span>
                <span id="inspector-action" class="text-amber-400 font-semibold text-right">inti.updateBlockField</span>
              </div>
              <div class="flex items-center justify-between gap-3 text-slate-400">
                <span>Written by:</span>
                <span id="inspector-target" class="text-sky-300 text-right">@intijs/adapter-wordpress</span>
              </div>
              <div class="flex items-center justify-between gap-3 text-slate-400">
                <span>Credentials:</span>
                <span class="text-slate-200 text-right">stay on your server</span>
              </div>
            </div>

            <!-- Action input viewer -->
            <div class="rounded-xl bg-black/60 border border-white/10 p-3.5 relative">
              <div class="flex items-center justify-between text-[11px] text-slate-400 mb-2">
                <span class="text-slate-300 font-semibold">Input of the action (example ids):</span>
              </div>
              <pre id="json-payload-display" aria-live="polite" class="text-xs text-amber-200/90 overflow-x-auto p-2 rounded bg-black/40 leading-relaxed font-mono"></pre>
            </div>
          </div>

          <!-- Security callout -->
          <div class="mt-6 p-3 rounded-lg bg-white/[0.03] border border-white/5 text-[11px] text-slate-400 leading-normal">
            <div class="flex items-center gap-1.5 text-amber-300 font-semibold mb-1">
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/>
              </svg>
              <span>Refused by default in production</span>
            </div>
            <span>In production Inti rejects every write unless a plugin you register decides who is editing. WordPress passwords and Kitsuden agent keys live only on the Astro server.</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  // Simulator logic. Nothing here talks to a server.
  const headingEl = document.getElementById('demo-heading');
  const subheadingEl = document.getElementById('demo-subheading');
  const ctaEl = document.getElementById('demo-cta');
  const variantSelect = document.getElementById('demo-variant-select') as HTMLSelectElement | null;
  const cmsSelect = document.getElementById('cms-select') as HTMLSelectElement | null;
  const jsonDisplay = document.getElementById('json-payload-display');
  const inspectorAction = document.getElementById('inspector-action');
  const inspectorTarget = document.getElementById('inspector-target');
  const blockEl = document.getElementById('interactive-block');
  const blockToolbar = document.getElementById('block-toolbar');
  const editorBanner = document.getElementById('editor-banner');
  const btnVisitor = document.getElementById('btn-mode-visitor');
  const btnEditor = document.getElementById('btn-mode-editor');
  const undoBtn = document.getElementById('undo-btn');

  type State = { heading: string; subheading: string; cta: string; variant: string };

  // Example document ids, in the shape each adapter uses
  const CMS: Record<string, { adapter: string; documentId: string }> = {
    wordpress: { adapter: '@intijs/adapter-wordpress', documentId: '42' },
    kitsuden: { adapter: '@intijs/adapter-kitsuden', documentId: '11111111-2222-3333-4444-555555555555' },
    strapi: { adapter: '@intijs/adapter-strapi', documentId: 'abc123' },
    keystatic: { adapter: '@intijs/adapter-keystatic', documentId: 'home' },
  };

  const VARIANT_CLASSES: Record<string, string> = {
    warm: 'border-amber-500/40 bg-gradient-to-br from-amber-950/30 to-slate-900',
    dark: 'border-slate-700 bg-slate-950',
    purple: 'border-purple-500/40 bg-gradient-to-br from-purple-950/30 to-slate-900',
  };
  const BLOCK_BASE = 'relative rounded-2xl p-6 sm:p-8 transition-all duration-300 border-2 shadow-xl group/block';

  let editing = true;
  let last = { field: 'heading', value: headingEl?.innerText.trim() ?? '' };
  const history: State[] = [];

  function readState(): State {
    return {
      heading: headingEl?.innerText ?? '',
      subheading: subheadingEl?.innerText ?? '',
      cta: ctaEl?.innerText ?? '',
      variant: variantSelect?.value ?? 'warm',
    };
  }

  function saveState() {
    history.push(readState());
    if (history.length > 20) history.shift();
  }

  function paintBlock() {
    if (!blockEl) return;
    const variant = VARIANT_CLASSES[variantSelect?.value ?? 'warm'] ?? VARIANT_CLASSES.warm;
    blockEl.className = `${BLOCK_BASE} ${editing ? 'border-dashed' : 'border-transparent'} ${variant}`;
  }

  // The input of `inti.updateBlockField`, as the real action declares it
  function showInput(field: string, value: string) {
    last = { field, value };
    const cms = CMS[cmsSelect?.value ?? 'wordpress'] ?? CMS.wordpress;
    if (inspectorAction) inspectorAction.textContent = 'inti.updateBlockField';
    if (inspectorTarget) inspectorTarget.textContent = cms.adapter;
    if (jsonDisplay) {
      jsonDisplay.textContent = JSON.stringify({ documentId: cms.documentId, blockIndex: 0, field, value }, null, 2);
    }
  }

  saveState();
  paintBlock();
  showInput(last.field, last.value);

  let debounceTimer: ReturnType<typeof setTimeout> | undefined;
  function handleInput(field: string, element: HTMLElement | null) {
    if (!element) return;
    clearTimeout(debounceTimer);
    debounceTimer = setTimeout(() => {
      saveState();
      showInput(field, element.innerText.trim());
    }, 200);
  }

  headingEl?.addEventListener('input', () => handleInput('heading', headingEl));
  subheadingEl?.addEventListener('input', () => handleInput('subheading', subheadingEl));
  ctaEl?.addEventListener('input', () => handleInput('cta.label', ctaEl));

  variantSelect?.addEventListener('change', () => {
    saveState();
    paintBlock();
    showInput('variant', variantSelect.value);
  });

  cmsSelect?.addEventListener('change', () => showInput(last.field, last.value));

  undoBtn?.addEventListener('click', () => {
    if (history.length < 2) return;
    history.pop();
    const prev = history[history.length - 1];
    if (!prev || !headingEl || !subheadingEl || !ctaEl || !variantSelect) return;
    headingEl.innerText = prev.heading;
    subheadingEl.innerText = prev.subheading;
    ctaEl.innerText = prev.cta;
    variantSelect.value = prev.variant;
    paintBlock();
    showInput('heading', prev.heading.trim());
  });

  // Visitor / editor view
  const ACTIVE = 'px-3 py-1.5 rounded-lg text-xs font-semibold bg-gradient-to-r from-amber-500 to-orange-500 text-white shadow-md transition-all';
  const INACTIVE = 'px-3 py-1.5 rounded-lg text-xs font-semibold text-slate-400 hover:text-white transition-all';

  function setEditing(next: boolean) {
    editing = next;
    if (btnEditor) { btnEditor.className = next ? ACTIVE : INACTIVE; btnEditor.setAttribute('aria-pressed', String(next)); }
    if (btnVisitor) { btnVisitor.className = next ? INACTIVE : ACTIVE; btnVisitor.setAttribute('aria-pressed', String(!next)); }
    blockToolbar?.classList.toggle('hidden', !next);
    editorBanner?.classList.toggle('hidden', !next);
    document.querySelectorAll('.field-label').forEach(el => el.classList.toggle('hidden', !next));
    for (const el of [headingEl, subheadingEl, ctaEl]) el?.setAttribute('contenteditable', String(next));
    paintBlock();
  }

  btnVisitor?.addEventListener('click', () => setEditing(false));
  btnEditor?.addEventListener('click', () => setEditing(true));

  // Tilt and light reflection: decoration only, off under reduced motion
  const windowEl = document.getElementById('demo-mockup-window');
  const specularEl = document.getElementById('mockup-specular');
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

  windowEl?.addEventListener('mousemove', (e) => {
    if (reduceMotion.matches) return;
    const rect = windowEl.getBoundingClientRect();
    const x = e.clientX - rect.left;
    const y = e.clientY - rect.top;
    const centerX = rect.width / 2;
    const centerY = rect.height / 2;

    const rotX = ((y - centerY) / centerY) * -5; // max 5 degrees
    const rotY = ((x - centerX) / centerX) * 5;

    windowEl.style.transform = `perspective(1200px) rotateX(${rotX.toFixed(2)}deg) rotateY(${rotY.toFixed(2)}deg)`;
    if (specularEl) {
      specularEl.style.opacity = '1';
      specularEl.style.background = `radial-gradient(circle 500px at ${x}px ${y}px, rgba(255, 255, 255, 0.08), transparent 70%)`;
    }
  });

  windowEl?.addEventListener('mouseleave', () => {
    windowEl.style.transform = '';
    if (specularEl) specularEl.style.opacity = '0';
  });
</script>
