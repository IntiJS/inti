---
// apps/demo-site/src/components/landing/Navbar.astro
import Sun from './Sun.astro';

// The home link respects the base path (GitHub Pages serves the site under /inti)
const home = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/`;
---

<header class="nav">
  <div class="nav-row">
    <a href={home} class="nav-box nav-brand" aria-label="Inti.js home, beta 0.1">
      <Sun rays={12} ray="#FF8A00" disc="#FF3D2E" />
      <span>inti.js</span>
      <small>beta 0.1</small>
    </a>

    <nav class="nav-box nav-links" aria-label="Main">
      <a href="#interactive-demo">Demo</a>
      <a href="#features">Features</a>
      <a href="#ai-playground">AI &amp; MCP</a>
      <a href="#adapters">Adapters</a>
    </nav>

    <div class="nav-box">
      <a href="https://github.com/intijs/inti" target="_blank" rel="noopener noreferrer" class="nav-ghost">GitHub (MIT)</a>
      <a href="#quickstart" class="nav-cta">Quickstart</a>
      <button
        type="button"
        id="mobile-menu-btn"
        class="nav-menu-btn"
        aria-label="Menu"
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true">
          <path d="M4 7h16M4 12h16M4 17h16" />
        </svg>
      </button>
    </div>
  </div>

  <nav id="mobile-menu" class="nav-drawer" aria-label="Main, mobile" hidden>
    <a href="#interactive-demo">Demo</a>
    <a href="#features">Features</a>
    <a href="#ai-playground">AI &amp; MCP</a>
    <a href="#adapters">Adapters</a>
    <a href="#quickstart">Quickstart</a>
    <a href="https://github.com/intijs/inti" target="_blank" rel="noopener noreferrer">GitHub (MIT)</a>
  </nav>
</header>

<script>
  const menuBtn = document.getElementById('mobile-menu-btn');
  const mobileMenu = document.getElementById('mobile-menu');
  const links = mobileMenu?.querySelectorAll('a');

  function setOpen(open: boolean) {
    if (mobileMenu) mobileMenu.hidden = !open;
    menuBtn?.setAttribute('aria-expanded', String(open));
  }

  menuBtn?.addEventListener('click', () => {
    setOpen(menuBtn.getAttribute('aria-expanded') !== 'true');
  });

  links?.forEach((link) => {
    link.addEventListener('click', () => setOpen(false));
  });

  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && menuBtn?.getAttribute('aria-expanded') === 'true') {
      setOpen(false);
      menuBtn.focus();
    }
  });
</script>
