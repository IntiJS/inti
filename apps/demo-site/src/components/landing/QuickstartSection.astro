---
// apps/demo-site/src/components/landing/QuickstartSection.astro

// The same prompt as in the repository README ("Paste this into your coding agent")
const agentPrompt = `Set up Inti (https://github.com/intijs/inti) for me. Inti is in beta and is NOT on
npm yet: do not run \`npm install @intijs/...\`, \`npm create inti\` or \`npx inti\`.

1. Clone https://github.com/intijs/inti.git next to this project. In the clone run
   \`npm install\` and then \`npm run build\`. It needs Node 22.12 or later.
2. Before writing any code, read AGENTS.md and llms.txt in the clone. AGENTS.md is
   the canonical setup: if another document disagrees with it, AGENTS.md is right.
3. For a new site, run this from the folder that contains the clone:
   \`node inti/scripts/scaffold-local.mjs <name> --cms <wordpress|kitsuden|strapi|keystatic|local> --yes\`
   Use \`local\` if I have not named a CMS.
   For an existing Astro site, follow "Installation" in the clone's README.md and
   then the complete setup in AGENTS.md. No step there is optional.
4. Use only the APIs, import paths, options and environment variables that appear
   in AGENTS.md, in a package README or in the source under packages/. Never
   invent one. If you cannot find what you need, stop and tell me.
5. CMS credentials stay on the server: never in client code and never in a
   PUBLIC_ variable. In production Inti refuses every write until a plugin with
   resolveActor/beforeWrite is registered in src/middleware.ts; do not work
   around that.
6. When you finish, start the dev server and tell me which page to open and
   which text to double-click.`;

const steps = [
  {
    n: 1,
    title: 'Clone and build',
    text: 'The packages are built from the repository. You need git and Node 22.12 or later.',
    commands: ['git clone https://github.com/intijs/inti.git', 'cd inti && npm install && npm run build && cd ..'],
  },
  {
    n: 2,
    title: 'Scaffold your site',
    text: 'It asks which CMS you use and sets up Astro, the adapter, the actions and a starter block.',
    commands: ['node inti/scripts/scaffold-local.mjs my-site'],
  },
  {
    n: 3,
    title: 'Run and edit',
    text: 'Open the page, double-click a text, type and press Enter. With no CMS it saves to a local JSON file.',
    commands: ['cd my-site && npm run dev'],
  },
];
---

<section id="quickstart" class="field field--ink">
  <div class="dome" data-scroll></div>
  <div class="wrap">
    <h2 class="h-pair" data-scroll>
      <span class="h-display drift-l">Get started today.</span>
      <span class="h-serif drift-r">Three steps from a clone.</span>
    </h2>
    <p style="margin-bottom: 1rem"><span class="sim">Not on npm yet: install from git</span></p>
    <p class="lede">
      The packages will be published under <code class="kbd-code">@intijs</code>. Until then the scaffolder runs from a clone of the repository and the project installs the packages from it. Once published, the whole thing is <code class="kbd-code">npm create inti@latest</code>.
    </p>

    <!-- Three steps -->
    <ol class="steps">
      {
        steps.map((step) => (
          <li class="step">
            <div>
              <b aria-hidden="true">{step.n}</b>
              <h3>{step.title}</h3>
              <p>{step.text}</p>
            </div>
            <div>
              {step.commands.map((command) => (
                <div class="cmd">
                  <span>{command}</span>
                  <button type="button" class="copy-btn" data-copy={command} aria-label={`Copy: ${command}`}>Copy</button>
                </div>
              ))}
            </div>
          </li>
        ))
      }
    </ol>

    <!-- Prompt for a coding agent -->
    <div class="win prompt">
      <div class="win-bar">
        <div>
          <h3>Prompt for my coding agent</h3>
          <p>For Claude Code, Cursor, Codex or any other agent. Paste it as it is.</p>
        </div>
        <button type="button" class="copy-btn btn" data-copy-from="agent-prompt">Copy prompt</button>
      </div>
      <pre id="agent-prompt" tabindex="0">{agentPrompt}</pre>
    </div>

    <!-- What the scaffolder prints (its real prompts) -->
    <div class="code term" tabindex="0" role="region" aria-label="Terminal, example session">
      <div class="code-head">
        <span>Terminal</span>
        <span>example session</span>
      </div>
      <p><span class="tk-s">$</span> node inti/scripts/scaffold-local.mjs my-site</p>
      <p class="tk-c">Packing the Inti packages into inti/.inti/tarballs…</p>
      <p>◆ Which CMS do you use? <strong class="tk-s">WordPress</strong> <span class="tk-c">(REST + ACF Flexible Content)</span></p>
      <p>◆ Install dependencies? <strong class="tk-s">Yes</strong></p>
      <p class="tk-k">✓ Project created in my-site (WordPress)</p>
      <br />
      <p><strong>Next steps:</strong></p>
      <p class="tk-s">&nbsp;&nbsp;cd my-site</p>
      <p class="tk-s">&nbsp;&nbsp;cp .env.example .env    # and fill in your CMS details</p>
      <p class="tk-s">&nbsp;&nbsp;npm run dev</p>
    </div>
  </div>
</section>

<script>
  // Copy buttons: `data-copy` holds the text, `data-copy-from` the id of the element to copy
  document.querySelectorAll<HTMLButtonElement>('.copy-btn').forEach((button) => {
    const label = button.textContent?.trim() || 'Copy';
    button.addEventListener('click', async () => {
      const from = button.dataset.copyFrom;
      const text = from ? document.getElementById(from)?.textContent ?? '' : button.dataset.copy ?? '';
      try {
        await navigator.clipboard.writeText(text);
        button.textContent = 'Copied';
        setTimeout(() => { button.textContent = label; }, 2000);
      } catch (e) {
        console.warn('Clipboard write failed', e);
      }
    });
  });
</script>
