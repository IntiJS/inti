---
// apps/demo-site/src/pages/index.astro
// Inti.js Official Landing Page & Interactive Showcase

import Navbar from '../components/landing/Navbar.astro';
import HeroSection from '../components/landing/HeroSection.astro';
import InteractiveEditorDemo from '../components/landing/InteractiveEditorDemo.astro';
import ComparisonSection from '../components/landing/ComparisonSection.astro';
import BentoFeatures from '../components/landing/BentoFeatures.astro';
import AIPlaygroundSection from '../components/landing/AIPlaygroundSection.astro';
import AdaptersSection from '../components/landing/AdaptersSection.astro';
import ArchitectureSection from '../components/landing/ArchitectureSection.astro';
import FaqSection from '../components/landing/FaqSection.astro';
import QuickstartSection from '../components/landing/QuickstartSection.astro';
import FooterSection from '../components/landing/FooterSection.astro';
import '../styles/landing.css';

// The site may be served under a base path (GitHub Pages: /inti). Every
// internal URL is built from it. `Astro.site` is only set for that build, so
// the canonical, og:url and og:image (which need an absolute URL) appear
// only there.
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const pageUrl = Astro.site ? new URL(`${base}/`, Astro.site).href : null;
const imageUrl = Astro.site ? new URL(`${base}/og.png`, Astro.site).href : null;

// Structured Data (JSON-LD) for Search Engines & AI Crawlers
const structuredData = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  "name": "Inti.js",
  "operatingSystem": "Cross-platform (Node.js, Cloudflare Workers, Vercel)",
  "applicationCategory": "DeveloperApplication",
  "offers": {
    "@type": "Offer",
    "price": "0",
    "priceCurrency": "USD"
  },
  "description": "AI for any CMS, without changing the CMS. Visual on-page editing for Astro with write-back to WordPress ACF, Kitsuden, Strapi, and Keystatic.",
  "softwareVersion": "0.1.0",
  "license": "https://opensource.org/licenses/MIT",
  "author": {
    "@type": "Person",
    "name": "Victor Antinori Broce"
  }
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
    
    <!-- Primary Meta Tags -->
    <title>Inti.js — edit your Astro site on the page, saved back to your CMS</title>
    <meta name="title" content="Inti.js — edit your Astro site on the page, saved back to your CMS" />
    <meta
      name="description"
      content="Live visual editing on your Astro site with automatic write-back to WordPress ACF, Kitsuden, Strapi, or Keystatic. Native AI agent support via MCP."
    />

    {pageUrl && <link rel="canonical" href={pageUrl} />}

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    {pageUrl && <meta property="og:url" content={pageUrl} />}
    {imageUrl && (
      <>
        <meta property="og:image" content={imageUrl} />
        <meta property="og:image:width" content="1200" />
        <meta property="og:image:height" content="630" />
        <meta property="og:image:alt" content="Inti.js: Edit your Astro site on the page. It saves back to the CMS you already have." />
      </>
    )}
    <meta property="og:title" content="Inti.js — edit your Astro site on the page, saved back to your CMS" />
    <meta
      property="og:description"
      content="Edit directly on your Astro page. Double-click, type, and persist back to your CMS. Without migrating your database or changing your editors' admin panel."
    />

    <!-- Twitter -->
    <meta name="twitter:card" content={imageUrl ? 'summary_large_image' : 'summary'} />
    {imageUrl && <meta name="twitter:image" content={imageUrl} />}
    <meta name="twitter:title" content="Inti.js — edit your Astro site on the page, saved back to your CMS" />
    <meta
      name="twitter:description"
      content="On-page visual editing for Astro sites on top of the CMS you already have. Generative UI, MCP agents and server-side personalization. Beta."
    />

    <!-- JSON-LD Structured Data -->
    <script is:inline type="application/ld+json" set:html={JSON.stringify(structuredData)} />

    <!-- Fonts are served from /fonts: nothing is requested from another host -->
    <link rel="preload" href={`${base}/fonts/archivo-latin-wdth-normal.woff2`} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={`${base}/fonts/instrument-serif-latin-400-normal.woff2`} as="font" type="font/woff2" crossorigin />
    <meta name="theme-color" content="#FFD60A" />
  </head>

  <body class="lp">
    <Navbar />

    <main>
      <!-- Hero (the headline is editable: a simulation), the marquee and four facts -->
      <HeroSection />

      <!-- Editor simulation (nothing is sent) -->
      <InteractiveEditorDemo />

      <!-- Why Inti, and the split slider: free-form builder vs. declared blocks -->
      <ComparisonSection />

      <!-- What Inti adds -->
      <BentoFeatures />

      <!-- The route of one save -->
      <ArchitectureSection />

      <!-- Generative UI simulation and the MCP server -->
      <AIPlaygroundSection />

      <!-- Adapters, with their real snippets -->
      <AdaptersSection />

      <FaqSection />

      <!-- Quickstart from git and the prompt for a coding agent -->
      <QuickstartSection />
    </main>

    <FooterSection />

    <script>
      import { initLandingMotion } from '../scripts/landing-motion';
      initLandingMotion();
    </script>
  </body>
</html>
