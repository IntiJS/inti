---
// apps/demo-site/src/pages/index.astro
// Inti.js Official Landing Page & Interactive Showcase

import Navbar from '../components/landing/Navbar.astro';
import HeroSection from '../components/landing/HeroSection.astro';
import InteractiveEditorDemo from '../components/landing/InteractiveEditorDemo.astro';
import ComparisonSection from '../components/landing/ComparisonSection.astro';
import BentoFeatures from '../components/landing/BentoFeatures.astro';
import DesignerVsBuilderSlider from '../components/landing/DesignerVsBuilderSlider.astro';
import Isometric3DStack from '../components/landing/Isometric3DStack.astro';
import AIPlaygroundSection from '../components/landing/AIPlaygroundSection.astro';
import AdaptersSection from '../components/landing/AdaptersSection.astro';
import ArchitectureSection from '../components/landing/ArchitectureSection.astro';
import FaqSection from '../components/landing/FaqSection.astro';
import QuickstartSection from '../components/landing/QuickstartSection.astro';
import FooterSection from '../components/landing/FooterSection.astro';

// Structured Data (JSON-LD) for Search Engines & AI Crawlers
const structuredData = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  "name": "Inti.js",
  "operatingSystem": "Cross-platform (Node.js, Cloudflare Workers, Vercel)",
  "applicationCategory": "DeveloperApplication",
  "offers": {
    "@type": "Offer",
    "price": "0",
    "priceCurrency": "USD"
  },
  "description": "AI for any CMS, without changing the CMS. Visual on-page editing for Astro with write-back to WordPress ACF, Kitsuden, Strapi, and Keystatic.",
  "softwareVersion": "0.1.0",
  "license": "https://opensource.org/licenses/MIT",
  "author": {
    "@type": "Person",
    "name": "Victor Antinori Broce"
  }
};
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    
    <!-- Primary Meta Tags -->
    <title>Inti.js — AI for any CMS, without changing the CMS</title>
    <meta name="title" content="Inti.js — AI for any CMS, without changing the CMS" />
    <meta
      name="description"
      content="Live visual editing on your Astro site with automatic write-back to WordPress ACF, Kitsuden, Strapi, or Keystatic. Native AI agent support via MCP."
    />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content="Inti.js — AI for any CMS, without changing the CMS" />
    <meta
      property="og:description"
      content="Edit directly on your Astro page. Double-click, type, and persist back to your CMS. Without migrating your database or changing your editors' admin panel."
    />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content="Inti.js — AI for any CMS, without changing the CMS" />
    <meta
      name="twitter:description"
      content="On-page visual editing for Astro sites on top of the CMS you already have. Generative UI, MCP agents and server-side personalization. Beta."
    />

    <!-- JSON-LD Structured Data -->
    <script is:inline type="application/ld+json" set:html={JSON.stringify(structuredData)} />

    <style is:global>
      /* Smooth custom scrollbars */
      ::-webkit-scrollbar {
        width: 8px;
        height: 8px;
      }
      ::-webkit-scrollbar-track {
        background: #07090E;
      }
      ::-webkit-scrollbar-thumb {
        background: #1F293D;
        border-radius: 4px;
      }
      ::-webkit-scrollbar-thumb:hover {
        background: #334155;
      }

      /* Visitors who ask for reduced motion get no CSS animation, no smooth
         scrolling and no transitions. The scripts check the same preference. */
      @media (prefers-reduced-motion: reduce) {
        html {
          scroll-behavior: auto !important;
        }
        *,
        *::before,
        *::after {
          animation-duration: 0.01ms !important;
          animation-iteration-count: 1 !important;
          transition-duration: 0.01ms !important;
        }
      }

      /* Selection highlight */
      ::selection {
        background: #FF7A00;
        color: #FFFFFF;
      }
    </style>
  </head>

  <body class="bg-[#06080F] text-slate-100 font-sans min-h-screen antialiased selection:bg-orange-500 selection:text-white">
    <!-- Navbar Header with Mobile Menu -->
    <Navbar />

    <!-- Main Landing Sections -->
    <main>
      <!-- Hero: what it is, the first command and four facts -->
      <HeroSection />

      <!-- Editor simulation (nothing is sent) -->
      <InteractiveEditorDemo />

      <!-- Why Inti? Ecosystem Comparison Matrix -->
      <ComparisonSection />

      <!-- Split slider: free-form builder vs. declared blocks -->
      <DesignerVsBuilderSlider />

      <!-- Interactive 3D Exploded Isometric Stack -->
      <div id="architecture-3d">
        <Isometric3DStack />
      </div>

      <!-- Bento grid of 7 core capabilities -->
      <BentoFeatures />

      <!-- Generative UI & AI Agents Playground (GenUI + MCP) -->
      <AIPlaygroundSection />

      <!-- Supported CMS Adapters Showcase -->
      <AdaptersSection />

      <!-- Clean & Secure Architecture -->
      <ArchitectureSection />

      <!-- Frequently Asked Questions Accordion -->
      <FaqSection />

      <!-- Quickstart from git and the prompt for a coding agent -->
      <QuickstartSection />
    </main>

    <!-- Footer Banner & Credits -->
    <FooterSection />
  </body>
</html>
