---
// src/pages/live.astro
// Forcing dynamic on-demand SSR
export const prerender = false;

// This code runs on the server on every request
const serverTime = Date.now();
const serverDate = new Date(serverTime).toLocaleString('en-US');
console.log(`[SSR] Rendering live.astro at ${serverDate}`);
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Gremio CMS - SSR</title>
    <style>
      body {
        font-family: system-ui, sans-serif;
        background-color: #0d1117;
        color: #c9d1d9;
        display: flex;
        align-items: center;
        justify-content: center;
        height: 100vh;
        margin: 0;
      }
      .container {
        text-align: center;
        padding: 2rem;
        border: 1px solid #e3b341;
        border-radius: 8px;
        background-color: #161b22;
      }
      h1 { color: #e3b341; }
      .time {
        font-family: monospace;
        background: #21262d;
        padding: 0.5rem;
        border-radius: 4px;
        display: inline-block;
        margin-top: 1rem;
      }
    </style>
  </head>
  <body>
    <div class="container">
      <h1>Gremio CMS - Dynamic Mode (SSR)</h1>
      <p>This page is being rendered on the server on demand.</p>
      <div class="time">
        Server Timestamp: {serverTime} <br/>
        Date: {serverDate}
      </div>
      <br/><br/>
      <a href="/" style="color: #8b949e;">Back to Home (SSG)</a>
    </div>
  </body>
</html>
