{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@intijs/core": ["../packages/core/src/index.ts"],
      "@intijs/core/*": ["../packages/core/src/*/index.ts"],
      "@/*": ["./src/*"]
    }
  },
  "include": ["src/**/*", "../packages/**/*"]
}
