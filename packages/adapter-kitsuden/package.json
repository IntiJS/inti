{
  "name": "@intijs/adapter-kitsuden",
  "version": "0.1.0",
  "type": "module",
  "license": "MIT",
  "author": "Victor Antinori Broce",
  "homepage": "https://github.com/intijs/inti/tree/main/packages/adapter-kitsuden#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/intijs/inti.git",
    "directory": "packages/adapter-kitsuden"
  },
  "bugs": {
    "url": "https://github.com/intijs/inti/issues"
  },
  "description": "Kitsuden CMS adapter for Inti.js — read + write-back against the Page Builder API",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./astro": {
      "import": "./dist/astro/index.js",
      "types": "./dist/astro/index.d.ts"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsc",
    "prepare": "node ../../scripts/prepare-package.mjs",
    "prepack": "node ../../scripts/prepare-package.mjs --clean",
    "dev": "tsc --watch",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "test": "bun test",
    "prepublishOnly": "npm test"
  },
  "peerDependencies": {
    "@intijs/core": "^0.1.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "^5.7.3"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "astro",
    "withastro",
    "kitsuden",
    "visual-editing",
    "inti"
  ]
}
