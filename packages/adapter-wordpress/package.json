{
  "name": "@intijs/adapter-wordpress",
  "version": "0.1.0",
  "type": "module",
  "license": "MIT",
  "author": "Victor Antinori Broce",
  "homepage": "https://github.com/intijs/inti/tree/main/packages/adapter-wordpress#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/intijs/inti.git",
    "directory": "packages/adapter-wordpress"
  },
  "bugs": {
    "url": "https://github.com/intijs/inti/issues"
  },
  "description": "Headless WordPress (REST + ACF) adapter for Inti.js — read + inline write-back",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsc",
    "prepare": "node ../../scripts/prepare-package.mjs",
    "dev": "tsc --watch",
    "clean": "rm -rf dist",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "@intijs/core": "^0.1.0"
  },
  "devDependencies": {
    "typescript": "^5.7.3"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "astro",
    "withastro",
    "wordpress",
    "headless-wordpress",
    "acf",
    "woocommerce",
    "visual-editing",
    "inti"
  ]
}
