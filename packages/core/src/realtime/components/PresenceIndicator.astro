---
/**
 * PresenceIndicator - Shows who is editing in real time
 * 
 * Shows avatars of connected users with status indicators.
 */

interface Props {
    /** Room ID */
    room: string;
    /** WebSocket endpoint */
    endpoint: string;
    /** Optional token */
    token?: string;
    /** Show the counter */
    showCount?: boolean;
    /** Maximum number of avatars to show */
    maxAvatars?: number;
    /** Position on the screen */
    position?: 'top-left' | 'top-right' | 'bottom-left' | 'bottom-right';
}

const { 
    room, 
    endpoint, 
    token,
    showCount = true,
    maxAvatars = 5,
    position = 'top-right'
} = Astro.props;

const config = {
    room,
    endpoint,
    token,
    presence: true
};

const positionClasses = {
    'top-left': 'top-4 left-4',
    'top-right': 'top-4 right-4',
    'bottom-left': 'bottom-4 left-4',
    'bottom-right': 'bottom-4 right-4'
};
---

<div 
    class={`inti-presence-indicator fixed ${positionClasses[position]} z-50`}
    data-config={JSON.stringify(config)}
    data-max-avatars={maxAvatars}
    data-show-count={showCount}
>
    <div class="inti-presence-container bg-white rounded-full shadow-lg border border-gray-200 px-3 py-2 flex items-center gap-2">
        <div class="inti-avatars-stack flex -space-x-2">
            <!-- Avatars are rendered here -->
        </div>
        
        {showCount && (
            <span class="inti-presence-count text-sm text-gray-600 font-medium hidden">
                +<span class="count">0</span>
            </span>
        )}
        
        <div class="inti-presence-status w-2 h-2 rounded-full bg-green-500 animate-pulse"></div>
    </div>
    
    <!-- User list on hover -->
    <div class="inti-presence-tooltip hidden absolute top-full mt-2 right-0 bg-white rounded-lg shadow-xl border border-gray-200 p-3 min-w-[200px]">
        <p class="text-xs font-semibold text-gray-500 uppercase tracking-wide mb-2">Active now</p>
        <ul class="inti-users-list space-y-2">
            <!-- User list -->
        </ul>
    </div>
</div>

<style>
    .inti-avatars-stack {
        direction: rtl;
    }
    
    .inti-avatar {
        width: 28px;
        height: 28px;
        border-radius: 50%;
        border: 2px solid white;
        overflow: hidden;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 12px;
        font-weight: 600;
        color: white;
        direction: ltr;
    }
    
    .inti-avatar img {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }
    
    .inti-presence-indicator:hover .inti-presence-tooltip {
        display: block;
    }
    
    .inti-user-item {
        display: flex;
        align-items: center;
        gap: 8px;
    }
    
    .inti-user-avatar {
        width: 24px;
        height: 24px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 10px;
        font-weight: 600;
        color: white;
    }
    
    .inti-user-info {
        flex: 1;
    }
    
    .inti-user-name {
        font-size: 13px;
        font-weight: 500;
        color: #111827;
    }
    
    .inti-user-status {
        font-size: 11px;
        color: #6b7280;
    }
    
    .inti-status-dot {
        width: 6px;
        height: 6px;
        border-radius: 50%;
        display: inline-block;
    }
    
    .inti-status-online { background: #10b981; }
    .inti-status-away { background: #f59e0b; }
    .inti-status-offline { background: #9ca3af; }
</style>

<script>
    import { initRealtime } from '../client.js';
    import type { UserPresence } from '../types.js';
    
    class PresenceManager {
        private container: HTMLElement;
        private config: any;
        private maxAvatars: number;
        private showCount: boolean;
        private avatarsStack: HTMLElement;
        private countElement: HTMLElement;
        private usersList: HTMLElement;
        private client: any;
        private users: Map<string, UserPresence> = new Map();
        
        constructor(container: HTMLElement) {
            this.container = container;
            this.config = JSON.parse(container.dataset.config || '{}');
            this.maxAvatars = parseInt(container.dataset.maxAvatars || '5');
            this.showCount = container.dataset.showCount === 'true';
            
            this.avatarsStack = container.querySelector('.inti-avatars-stack')!;
            this.countElement = container.querySelector('.inti-presence-count .count')!;
            this.usersList = container.querySelector('.inti-users-list')!;
            
            this.init();
        }
        
        private async init() {
            this.client = initRealtime(this.config);
            await this.client.connect();
            
            // Listen to presence
            this.client.on('user_join', (event) => {
                this.addUser(event.data);
            });
            
            this.client.on('user_leave', (event) => {
                this.removeUser(event.data.userId);
            });
            
            // Cleanup
            window.addEventListener('beforeunload', () => {
                this.client.disconnect();
            });
        }
        
        private addUser(user: UserPresence) {
            this.users.set(user.userId, user);
            this.render();
        }
        
        private removeUser(userId: string) {
            this.users.delete(userId);
            this.render();
        }
        
        private render() {
            const users = Array.from(this.users.values());
            
            // Render avatars
            this.avatarsStack.innerHTML = '';
            const visibleUsers = users.slice(0, this.maxAvatars);
            
            visibleUsers.forEach(user => {
                const avatar = this.createAvatar(user);
                this.avatarsStack.appendChild(avatar);
            });
            
            // Show the counter if there are more users
            if (this.showCount && users.length > this.maxAvatars) {
                const extra = users.length - this.maxAvatars;
                const countEl = this.container.querySelector('.inti-presence-count');
                if (countEl) {
                    countEl.classList.remove('hidden');
                    this.countElement.textContent = String(extra);
                }
            }
            
            // Render the user list
            this.usersList.innerHTML = '';
            users.forEach(user => {
                const item = this.createUserListItem(user);
                this.usersList.appendChild(item);
            });
            
            // Hide if there are no users
            const container = this.container.querySelector('.inti-presence-container') as HTMLElement;
            if (users.length === 0) {
                container.style.display = 'none';
            } else {
                container.style.display = 'flex';
            }
        }
        
        private createAvatar(user: UserPresence): HTMLElement {
            const div = document.createElement('div');
            div.className = 'inti-avatar';
            div.style.backgroundColor = user.color;
            div.title = user.name;
            
            if (user.avatar) {
                div.innerHTML = `<img src="${user.avatar}" alt="${user.name}">`;
            } else {
                div.textContent = this.getInitials(user.name);
            }
            
            return div;
        }
        
        private createUserListItem(user: UserPresence): HTMLElement {
            const li = document.createElement('li');
            li.className = 'inti-user-item';
            
            const statusClass = `inti-status-${user.status}`;
            
            li.innerHTML = `
                <div class="inti-user-avatar" style="background-color: ${user.color}">
                    ${user.avatar ? 
                        `<img src="${user.avatar}" alt="${user.name}" style="width:100%;height:100%;object-fit:cover;border-radius:50%">` : 
                        this.getInitials(user.name)
                    }
                </div>
                <div class="inti-user-info">
                    <div class="inti-user-name">${user.name}</div>
                    <div class="inti-user-status">
                        <span class="inti-status-dot ${statusClass}"></span>
                        ${user.status}
                    </div>
                </div>
            `;
            
            return li;
        }
        
        private getInitials(name: string): string {
            return name
                .split(' ')
                .map(n => n[0])
                .join('')
                .toUpperCase()
                .slice(0, 2);
        }
    }
    
    // Initialize
    document.addEventListener('DOMContentLoaded', () => {
        const containers = document.querySelectorAll('.inti-presence-indicator');
        containers.forEach(container => {
            new PresenceManager(container as HTMLElement);
        });
    });
</script>
