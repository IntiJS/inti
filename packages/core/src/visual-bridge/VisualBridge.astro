---
/**
 * VisualBridge - Visual Editing component for Astro
 * 
 * Injects the visual editing system into the page.
 * Only renders in development mode or when explicitly enabled.
 */

import type { VisualBridgeConfig } from './types.js';

interface Props {
    config: VisualBridgeConfig;
}

const { config } = Astro.props;

// Only render if enabled
const shouldRender = config.enabled && (
    process.env.NODE_ENV === 'development' || 
    Astro.url.searchParams.has('intiEdit')
);

// Render nothing on the server if not enabled
if (!shouldRender) return null;
---

{shouldRender && (
    <>
        {/* Styles */}
        <style is:global>
            /* ========================================
               Visual Bridge Styles
               ======================================== */
            
            /* Main overlay */
            #inti-visual-bridge {
                position: fixed;
                top: 0;
                left: 0;
                width: 100%;
                height: 100%;
                pointer-events: none;
                z-index: 999999;
                font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
            }
            
            #inti-visual-bridge > * {
                pointer-events: auto;
            }

            /*
             * The highlight is a box positioned ON TOP of the block. It declares
             * pointer-events: none further down, but the rule above wins on
             * specificity (an id outweighs a class): once a block was
             * selected, its box swallowed double clicks and its fields
             * stopped being editable. It is repeated with the same
             * specificity so it wins.
             */
            #inti-visual-bridge > .inti-vb-highlight {
                pointer-events: none;
            }
            
            /* Main toolbar */
            .inti-vb-toolbar {
                position: fixed;
                top: 1rem;
                right: 1rem;
                background: #1e293b;
                border-radius: 0.5rem;
                padding: 0.75rem 1rem;
                box-shadow: 0 10px 40px rgba(0, 0, 0, 0.3);
                display: flex;
                align-items: center;
                gap: 1rem;
                min-width: 280px;
            }
            
            .inti-vb-toolbar-header {
                display: flex;
                align-items: center;
                gap: 0.5rem;
                flex: 1;
            }
            
            .inti-vb-logo {
                font-weight: 600;
                color: #f8fafc;
                font-size: 0.875rem;
            }
            
            .inti-vb-cms {
                background: #3b82f6;
                color: white;
                padding: 0.125rem 0.5rem;
                border-radius: 0.25rem;
                font-size: 0.625rem;
                font-weight: 600;
                text-transform: uppercase;
                letter-spacing: 0.05em;
            }
            
            .inti-vb-toolbar-actions {
                display: flex;
                gap: 0.5rem;
            }
            
            .inti-vb-btn {
                background: #334155;
                border: none;
                color: #cbd5e1;
                width: 2rem;
                height: 2rem;
                border-radius: 0.375rem;
                cursor: pointer;
                display: flex;
                align-items: center;
                justify-content: center;
                transition: all 0.2s;
                font-size: 1rem;
            }
            
            .inti-vb-btn:hover {
                background: #475569;
                color: #f8fafc;
            }
            
            .inti-vb-btn-danger:hover {
                background: #ef4444;
                color: white;
            }
            
            /* Block Toolbar */
            .inti-vb-block-toolbar {
                position: absolute;
                background: #1e293b;
                border-radius: 0.5rem;
                padding: 0.5rem;
                box-shadow: 0 10px 40px rgba(0, 0, 0, 0.3);
                display: flex;
                align-items: center;
                gap: 0.75rem;
                z-index: 1000000;
                animation: inti-vb-slide-in 0.2s ease;
            }
            
            @keyframes inti-vb-slide-in {
                from {
                    opacity: 0;
                    transform: translateY(-10px);
                }
                to {
                    opacity: 1;
                    transform: translateY(0);
                }
            }
            
            .inti-vb-block-type {
                font-size: 0.75rem;
                font-weight: 600;
                color: #94a3b8;
                text-transform: uppercase;
                letter-spacing: 0.05em;
                padding: 0 0.5rem;
                border-right: 1px solid #334155;
            }
            
            .inti-vb-block-actions {
                display: flex;
                gap: 0.25rem;
            }
            
            /* Highlight */
            .inti-vb-highlight {
                position: absolute;
                border: 2px dashed #3b82f6;
                border-radius: 0.25rem;
                pointer-events: none;
                transition: all 0.15s ease;
                z-index: 999998;
            }
            
            .inti-vb-highlight.inti-vb-selected {
                border: 2px solid #3b82f6;
                background: rgba(59, 130, 246, 0.05);
                box-shadow: 0 0 0 4px rgba(59, 130, 246, 0.1);
            }
            
            /* Toast Container */
            .inti-vb-toast-container {
                position: fixed;
                bottom: 1rem;
                right: 1rem;
                display: flex;
                flex-direction: column;
                gap: 0.5rem;
                z-index: 1000001;
            }
            
            .inti-vb-toast {
                background: #1e293b;
                color: #f8fafc;
                padding: 0.75rem 1rem;
                border-radius: 0.5rem;
                box-shadow: 0 10px 40px rgba(0, 0, 0, 0.3);
                font-size: 0.875rem;
                max-width: 300px;
                opacity: 0;
                transform: translateX(100%);
                transition: all 0.3s ease;
            }
            
            .inti-vb-toast-visible {
                opacity: 1;
                transform: translateX(0);
            }
            
            .inti-vb-toast-success {
                border-left: 4px solid #10b981;
            }
            
            .inti-vb-toast-error {
                border-left: 4px solid #ef4444;
            }
            
            .inti-vb-toast-warning {
                border-left: 4px solid #f59e0b;
            }
            
            .inti-vb-toast-info {
                border-left: 4px solid #3b82f6;
            }
            
            /* Block detection */
            .inti-vb-detectable {
                position: relative;
            }
            
            body.inti-vb-show-borders .inti-vb-detectable {
                outline: 1px dashed rgba(59, 130, 246, 0.3);
            }
            
            body.inti-vb-show-borders .inti-vb-detectable:hover {
                outline: 2px dashed #3b82f6;
            }
            
            .inti-vb-detectable.inti-vb-selected {
                outline: 2px solid #3b82f6 !important;
            }
            
            /* Keyboard focus is always visible */
            .inti-vb-btn:focus-visible {
                outline: 2px solid #93c5fd;
                outline-offset: 2px;
            }

            /* No slide-in or fades for someone who asked for reduced motion */
            @media (prefers-reduced-motion: reduce) {
                .inti-vb-overlay,
                .inti-vb-overlay * {
                    animation: none !important;
                    transition: none !important;
                }
            }

            /* Light theme */
            .inti-vb-theme-light .inti-vb-toolbar,
            .inti-vb-theme-light .inti-vb-block-toolbar {
                background: #ffffff;
                border: 1px solid #e5e7eb;
            }
            
            .inti-vb-theme-light .inti-vb-logo {
                color: #111827;
            }
            
            .inti-vb-theme-light .inti-vb-btn {
                background: #f3f4f6;
                color: #374151;
            }
            
            .inti-vb-theme-light .inti-vb-btn:hover {
                background: #e5e7eb;
            }
            
            .inti-vb-theme-light .inti-vb-block-type {
                color: #6b7280;
                border-color: #e5e7eb;
            }
            
            .inti-vb-theme-light .inti-vb-toast {
                background: #ffffff;
                color: #111827;
                border: 1px solid #e5e7eb;
            }
        </style>
        
        {/* Container for config */}
        <div id="inti-visual-bridge-config" data-config={JSON.stringify(config)} style="display: none;"></div>

        {/* Script */}
        <script>
            // The engine is imported DYNAMICALLY: with a static import,
            // Astro bundles it into the entry chunk and every visitor
            // downloads the editor even if they never use it. This way it
            // stays in a separate chunk that is only requested if the marker exists.
            const configElement = document.getElementById('inti-visual-bridge-config');

            if (configElement) {
                const start = async () => {
                    try {
                        const config = JSON.parse(configElement.dataset.config || '{}');
                        const { initVisualBridge } = await import('./engine.js');
                        initVisualBridge(config);
                    } catch (e) {
                        console.error('[VisualBridge] Failed to start', e);
                    }
                };

                if (document.readyState === 'loading') {
                    document.addEventListener('DOMContentLoaded', () => void start());
                } else {
                    void start();
                }
            }
        </script>
    </>
)}
