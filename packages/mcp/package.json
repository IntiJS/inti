{
  "name": "@intijs/mcp",
  "version": "0.1.0",
  "type": "module",
  "license": "MIT",
  "author": "Victor Antinori Broce",
  "homepage": "https://github.com/intijs/inti/tree/main/packages/mcp#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/intijs/inti.git",
    "directory": "packages/mcp"
  },
  "bugs": {
    "url": "https://github.com/intijs/inti/issues"
  },
  "description": "MCP server for Inti.js — let AI agents read and edit your headless CMS content",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "inti",
    "astro",
    "cms",
    "wordpress",
    "headless-cms",
    "ai"
  ],
  "bin": {
    "inti-mcp": "./bin/inti-mcp.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "bin",
    "src",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "prepare": "node ../../scripts/prepare-package.mjs",
    "dev": "tsc --watch",
    "clean": "rm -rf dist",
    "test": "bun test",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@intijs/genui": "^0.1.0",
    "@modelcontextprotocol/sdk": "^1.29.0"
  },
  "peerDependencies": {
    "@intijs/core": "^0.1.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "^5.7.3"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
